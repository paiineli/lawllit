@{
    var currentLanguage = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var pageTitle = (ViewData["Title"] as string) ?? Localizer["SiteTitle"].Value;
}
<!DOCTYPE html>
<html lang="@currentLanguage" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@Localizer["SiteDescription"]" />
    <link rel="canonical" href="https://lawllit.com@(Context.Request.Path)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="lawllit" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@Localizer["SiteDescription"]" />
    <meta property="og:url" content="https://lawllit.com@(Context.Request.Path)" />
    <meta property="og:image" content="https://lawllit.com/og-image.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@Localizer["SiteDescription"]" />
    <meta name="twitter:image" content="https://lawllit.com/og-image.png" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23000'/><text x='50%25' y='55%25' dominant-baseline='middle' text-anchor='middle' fill='%23fff' font-family='monospace' font-weight='bold' font-size='18'>L.</text></svg>" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg sticky-top border-bottom" id="main-nav">
        <div class="container-lg">
            <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">lawllit<span class="brand-dot">.</span></a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavContent" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavContent">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item me-3">
                        <a class="nav-link nav-link-finance" asp-area="Finance" asp-controller="Home" asp-action="Index">finance</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">@Localizer["Nav_Tools"]</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Tools" asp-action="SpreadsheetMerger">@Localizer["Nav_Tools_SpreadsheetMerger"]</a></li>
                            <li><a class="dropdown-item" asp-controller="Tools" asp-action="PdfMerger">@Localizer["Nav_Tools_PdfMerger"]</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Tools" asp-action="Base64">@Localizer["Nav_Tools_Base64"]</a></li>
                            <li><a class="dropdown-item" asp-controller="Tools" asp-action="TextCase">@Localizer["Nav_Tools_TextCase"]</a></li>
                            <li><a class="dropdown-item" asp-controller="Tools" asp-action="SqlList">@Localizer["Nav_Tools_SqlList"]</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Tools" asp-action="CpfCnpj">@Localizer["Nav_Tools_CpfCnpj"]</a></li>
                            <li><a class="dropdown-item" asp-controller="Tools" asp-action="CepLookup">@Localizer["Nav_Tools_CepLookup"]</a></li>
                            <li><a class="dropdown-item" asp-controller="Tools" asp-action="QrCode">@Localizer["Nav_Tools_QrCode"]</a></li>
                        </ul>
                    </li>
                </ul>
                <form asp-controller="Home" asp-action="SetLanguage" method="post" class="lang-switcher ms-3 mb-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit" name="language" value="pt-BR" class="lang-btn @(currentLanguage == "pt-BR" ? "lang-btn-active" : "")" aria-label="Português"><span class="fi fi-br"></span></button>
                    <button type="submit" name="language" value="en-US" class="lang-btn @(currentLanguage == "en-US" ? "lang-btn-active" : "")" aria-label="English"><span class="fi fi-us"></span></button>
                </form>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer class="site-footer">
        <div class="container-lg footer-shell">
            <span>© @DateTime.Now.Year <span class="footer-brand">lawllit<span class="brand-dot">.</span></span></span>
            <div class="footer-links">
                <a href="mailto:support@lawllit.com" aria-label="Email"><i class="bi bi-envelope"></i></a>
                <a href="https://www.linkedin.com/in/paiineli/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
