<main class="lp-main">
    <div class="container-lg d-flex justify-content-center">
        <div class="lp-body">

            <header class="lp-header">
                <h1 class="lp-name">@Localizer["Tools_Title"]</h1>
                <p class="lp-text">@Localizer["Tools_Subtitle"]</p>
            </header>

            <section class="lp-section">
                <p class="lp-section-title">@Localizer["Tools_SectionTag"]</p>
                <div class="tools-grid">
                    <a class="tool-card" asp-controller="Tools" asp-action="SpreadsheetMerger">
                        <span class="tool-card-name">@Localizer["Tool_SpreadsheetMerger_Name"]</span>
                        <span class="tool-card-desc">@Localizer["Tool_SpreadsheetMerger_Desc"]</span>
                    </a>
                    <a class="tool-card" asp-controller="Tools" asp-action="PdfMerger">
                        <span class="tool-card-name">@Localizer["Tool_PdfMerger_Name"]</span>
                        <span class="tool-card-desc">@Localizer["Tool_PdfMerger_Desc"]</span>
                    </a>
                    <a class="tool-card" asp-controller="Tools" asp-action="Base64">
                        <span class="tool-card-name">@Localizer["Tool_Base64_Name"]</span>
                        <span class="tool-card-desc">@Localizer["Tool_Base64_Desc"]</span>
                    </a>
                    <a class="tool-card" asp-controller="Tools" asp-action="TextCase">
                        <span class="tool-card-name">@Localizer["Tool_TextCase_Name"]</span>
                        <span class="tool-card-desc">@Localizer["Tool_TextCase_Desc"]</span>
                    </a>
                    <a class="tool-card" asp-controller="Tools" asp-action="SqlList">
                        <span class="tool-card-name">@Localizer["Tool_SqlList_Name"]</span>
                        <span class="tool-card-desc">@Localizer["Tool_SqlList_Desc"]</span>
                    </a>
                    <a class="tool-card" asp-controller="Tools" asp-action="CpfCnpj">
                        <span class="tool-card-name">@Localizer["Tool_CpfCnpj_Name"]</span>
                        <span class="tool-card-desc">@Localizer["Tool_CpfCnpj_Desc"]</span>
                    </a>
                    <a class="tool-card" asp-controller="Tools" asp-action="CepLookup">
                        <span class="tool-card-name">@Localizer["Tool_CepLookup_Name"]</span>
                        <span class="tool-card-desc">@Localizer["Tool_CepLookup_Desc"]</span>
                    </a>
                    <a class="tool-card" asp-controller="Tools" asp-action="QrCode">
                        <span class="tool-card-name">@Localizer["Tool_QrCode_Name"]</span>
                        <span class="tool-card-desc">@Localizer["Tool_QrCode_Desc"]</span>
                    </a>
                </div>
            </section>

        </div>
    </div>
</main>
