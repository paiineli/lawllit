<main class="lp-main">
    <div class="container-lg d-flex justify-content-center">
        <div class="lp-body">

            <header class="lp-header">
                <p class="lp-section-title"><a asp-controller="Tools" asp-action="Index">@Localizer["Tools_Title"]</a></p>
                <h1 class="lp-name">@Localizer["SpreadsheetMerger_Title"]</h1>
            </header>

            <section class="lp-section">
                <p class="lp-section-title">@Localizer["SpreadsheetMerger_HowItWorksTag"]</p>
                <ol class="tool-steps">
                    <li>@Localizer["SpreadsheetMerger_Step1"]</li>
                    <li>@Localizer["SpreadsheetMerger_Step2"]</li>
                    <li>@Localizer["SpreadsheetMerger_Step3"]</li>
                    <li>@Localizer["SpreadsheetMerger_Step4"]</li>
                </ol>
            </section>

            <section class="lp-section">
                <p class="lp-section-title">@Localizer["SpreadsheetMerger_UploadTag"]</p>
                <form asp-controller="Tools" asp-action="SpreadsheetMerger" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="tool-upload-area">
                        <input type="file" id="files-input" name="files" multiple accept=".xlsx,.xls" class="visually-hidden" />
                        <label for="files-input" class="tool-upload-label">
                            <i class="bi bi-file-earmark-spreadsheet"></i>
                            <span>@Localizer["SpreadsheetMerger_ChooseFiles"]</span>
                            <span class="lp-edu-meta">@Localizer["SpreadsheetMerger_Hint"]</span>
                        </label>
                    </div>
                    <div id="file-list" class="tool-file-list" hidden></div>
                    @if (ViewBag.ErrorKey != null)
                    {
                        <p class="tool-error">@Localizer[ViewBag.ErrorKey]</p>
                    }
                    <button type="submit" id="merge-btn" class="lp-btn" disabled>@Localizer["SpreadsheetMerger_MergeBtn"]</button>
                </form>
            </section>

        </div>
    </div>
</main>

<div id="merge-overlay" class="merge-overlay" hidden>
    <p id="overlay-label" class="merge-overlay-label" data-template="@Localizer["Merger_OverlayFile"]"></p>
    <div class="merge-overlay-track">
        <div id="overlay-progress" class="merge-overlay-fill"></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="~/js/spreadsheet-merger.js" asp-append-version="true"></script>
}
