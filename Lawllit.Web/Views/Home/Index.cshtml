@{
    ViewData["Title"] = "lawllit.";
}

<main class="lp-main">
    <div class="container-lg d-flex justify-content-center">
        <div class="lp-body">

            <header class="lp-header">
                <h1 class="lp-name">Lucas Paineli Gimenes</h1>
                <div class="lp-icons">
                    <a href="mailto:painelilucas@gmail.com" aria-label="Email"><i class="bi bi-envelope"></i></a>
                    <a href="https://www.linkedin.com/in/paiineli" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    <a href="https://github.com/paiineli" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><i class="bi bi-github"></i></a>
                </div>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <a href="/curriculo-lpg-ptbr.html?print=1" target="_blank" class="lp-btn">currículo pt-br</a>
                    <a href="/curriculo-lpg-enus.html?print=1" target="_blank" class="lp-btn">resume en-us</a>
                </div>
            </header>

            <section class="lp-section">
                <p class="lp-section-title">@Localizer["Home_EducationTag"]</p>
                <div class="lp-edu">
                    <div class="lp-edu-item">
                        <span>@Localizer["Home_Edu1_Title"]</span>
                        <span class="lp-edu-meta">@Localizer["Home_Edu1_Meta"]</span>
                    </div>
                    <div class="lp-edu-item">
                        <span>@Localizer["Home_Edu2_Title"]</span>
                        <span class="lp-edu-meta">@Localizer["Home_Edu2_Meta"]</span>
                    </div>
                    <div class="lp-edu-item">
                        <span>@Localizer["Home_Edu3_Title"]</span>
                        <span class="lp-edu-meta">@Localizer["Home_Edu3_Meta"]</span>
                    </div>
                </div>
            </section>

            <section class="lp-section">
                <p class="lp-section-title">@Localizer["Home_CertificationsTag"]</p>
                <div class="lp-edu">
                    <div class="lp-edu-item">
                        <span>@Localizer["Home_Cert1_Title"]</span>
                        <span class="lp-edu-meta">@Localizer["Home_Cert1_Meta"]</span>
                    </div>
                    <div class="lp-edu-item">
                        <span>@Localizer["Home_Cert2_Title"]</span>
                        <span class="lp-edu-meta">@Localizer["Home_Cert2_Meta"]</span>
                    </div>
                </div>
            </section>

            <section class="lp-section">
                <p class="lp-section-title">@Localizer["Home_LanguagesTag"]</p>
                <div class="lp-lang">
                    <div class="lp-lang-item">
                        <span>@Localizer["Home_Lang1_Name"]</span>
                        <span class="lp-edu-meta">@Localizer["Home_Lang1_Level"]</span>
                    </div>
                    <div class="lp-lang-item">
                        <span>@Localizer["Home_Lang2_Name"]</span>
                        <span class="lp-edu-meta">@Localizer["Home_Lang2_Level"]</span>
                    </div>
                </div>
            </section>

            <section class="lp-section">
                <p class="lp-section-title">@Localizer["Home_SummaryTag"]</p>
                <p class="lp-text">@Localizer["Home_Summary_P1"]</p>
                <p class="lp-text lp-text-gap">@Localizer["Home_Summary_P2"]</p>
                <p class="lp-text lp-text-gap">@Localizer["Home_Summary_P3"]</p>
            </section>

            <section class="lp-section lp-cta">
                <p class="lp-section-title">@Localizer["Home_ProjectsTag"]</p>
                <p class="lp-text">
                    @Localizer["Home_Finance_Desc_Pre"]<span class="lp-finance-brand">lawllit<span class="lp-finance-dot">.</span><span class="lp-finance-text">finance</span></span>@Localizer["Home_Finance_Desc_Post"]
                </p>
                <a href="/Finance" class="lp-btn lp-btn-cta">@Localizer["Home_Finance_CTA"]</a>
            </section>

        </div>
    </div>
</main>
