<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Limpa qualquer fonte herdada da máquina, como feed corporativo, para o build
       local e o do CI restaurarem exatamente do mesmo lugar. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
