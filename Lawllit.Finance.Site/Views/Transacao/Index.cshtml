@model TransacaoListaViewModel
@{
    ViewData["Title"] = "Transações";

    // O app é em real, então a formatação é sempre pt-BR.
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var hoje = HorarioBrasil.Agora.Date;
    var nomeMes = cultura.DateTimeFormat.GetMonthName(Model.FiltroMes);
    nomeMes = char.ToUpper(nomeMes[0]) + nomeMes[1..];

    var mesAnterior = new DateTime(Model.FiltroAno, Model.FiltroMes, 1).AddMonths(-1);
    var proximoMes = new DateTime(Model.FiltroAno, Model.FiltroMes, 1).AddMonths(1);

    // O select de categoria agrupa por tipo, sempre nesta ordem, que é a mesma do controle de tipo.
    var tiposTransacao = new[] { TipoTransacaoEnum.DESPESA, TipoTransacaoEnum.RECEITA, TipoTransacaoEnum.INVESTIMENTO };

    var filtros = new (string Rotulo, TipoTransacaoEnum? Tipo)[]
    {
        ("Tudo", null),
        ("Entrou", TipoTransacaoEnum.RECEITA),
        ("Saiu", TipoTransacaoEnum.DESPESA),
        ("Investido", TipoTransacaoEnum.INVESTIMENTO),
    };

    var dias = Model.Transacoes
        .GroupBy(transacao => transacao.Data.Date)
        .OrderByDescending(grupo => grupo.Key);

    string Moeda(decimal valor) => valor.ToString("C", cultura);

    string NomeDoDia(DateTime dia) => dia == hoje ? "Hoje"
        : dia == hoje.AddDays(-1) ? "Ontem"
        : dia.ToString(dia.Year == hoje.Year ? "d 'de' MMMM" : "d 'de' MMMM 'de' yyyy", cultura);

    // O saldo do dia abate o investimento, igual ao saldo do painel.
    string TotalDoDia(IEnumerable<TransacaoItemModel> transacoes)
    {
        var total = transacoes.Sum(transacao => transacao.Tipo == TipoTransacaoEnum.RECEITA ? transacao.Valor : -transacao.Valor);
        return (total >= 0 ? "+ " : "− ") + Moeda(Math.Abs(total));
    }

    string ValoresDaNova() => System.Text.Json.JsonSerializer.Serialize(new
    {
        Tipo = TipoTransacaoEnum.DESPESA.ToString(),
        Data = hoje.ToString("yyyy-MM-dd"),
    });

    string ValoresDe(TransacaoItemModel transacao) => System.Text.Json.JsonSerializer.Serialize(new
    {
        Tipo = transacao.Tipo.ToString(),
        Valor = transacao.Valor.ToString("F2", cultura),
        Descricao = transacao.Descricao ?? string.Empty,
        Data = transacao.Data.ToString("yyyy-MM-dd"),
        CodigoCategoria = transacao.CodigoCategoria,
        Recorrente = transacao.Recorrente,
    });
}

<main class="conteiner pagina">
    <div class="cabecalho-pagina">
        <div class="periodo">
            <a class="botao botao-icone botao-icone-plano" asp-action="Index" asp-route-tipo="@Model.FiltroTipo"
               asp-route-mes="@mesAnterior.Month" asp-route-ano="@mesAnterior.Year" aria-label="Mês anterior"><icone nome="chevron-esquerda" /></a>
            <div>
                <p class="texto-pequeno texto-suave">@nomeMes de @Model.FiltroAno · @Model.Pagina.TotalItens lançamentos</p>
                <h1 class="titulo-grande">Transações</h1>
            </div>
            <a class="botao botao-icone botao-icone-plano" asp-action="Index" asp-route-tipo="@Model.FiltroTipo"
               asp-route-mes="@proximoMes.Month" asp-route-ano="@proximoMes.Year" aria-label="Próximo mês"><icone nome="chevron-direita" /></a>
        </div>

        <div class="linha">
            @if (Model.Transacoes.Any())
            {
                <a class="botao botao-contorno botao-recolhe" asp-action="Exportar" asp-route-tipo="@Model.FiltroTipo" asp-route-mes="@Model.FiltroMes"
                   asp-route-ano="@Model.FiltroAno" asp-route-busca="@Model.FiltroBusca" aria-label="Exportar"><icone nome="download" /><span>Exportar</span></a>
            }
            @if (Model.Categorias.Any())
            {
                <button type="button" class="botao botao-primario so-computador" data-editar="gaveta-transacao"
                        data-titulo="Novo lançamento" data-acao="@Url.Action("Criar")" data-valores="@ValoresDaNova()"
                        data-nova-transacao><icone nome="mais" />Novo lançamento</button>
            }
        </div>
    </div>

    <div class="filtros">
        @* Digitando filtra a página na hora; o Enter manda para o servidor, que procura em todas as páginas do mês. *@
        <form class="busca" method="get" asp-action="Index" role="search">
            <icone nome="lupa" />
            <input type="hidden" name="tipo" value="@Model.FiltroTipo" />
            <input type="hidden" name="mes" value="@Model.FiltroMes" />
            <input type="hidden" name="ano" value="@Model.FiltroAno" />
            <input type="search" name="busca" placeholder="Buscar" aria-label="Buscar transação" value="@Model.FiltroBusca" data-busca-viva />
        </form>
        <nav class="chips" aria-label="Filtrar por tipo">
            @foreach (var filtro in filtros)
            {
                <a class="chip" asp-action="Index" asp-route-tipo="@filtro.Tipo" asp-route-mes="@Model.FiltroMes" asp-route-ano="@Model.FiltroAno"
                   asp-route-busca="@Model.FiltroBusca" aria-current="@(Model.FiltroTipo == filtro.Tipo ? "page" : null)">@filtro.Rotulo</a>
            }
        </nav>
    </div>

    @if (Model.RecorrentesPendentes > 0)
    {
        <div class="alerta alerta-info alerta-acao">
            <icone nome="repetir" />
            <span>@Model.RecorrentesPendentes @(Model.RecorrentesPendentes == 1 ? "lançamento que se repete todo mês ainda não entrou" : "lançamentos que se repetem todo mês ainda não entraram") neste mês.</span>
            <form method="post" asp-action="ImportarRecorrentes">
                <partial name="_CamposFiltro" model="Model.FiltroRota" />
                <button type="submit" class="botao botao-escuro">Lançar agora</button>
            </form>
        </div>
    }

    @if (Model.Transacoes.Any())
    {
        <div class="totais">
            <p class="total"><span class="legenda-solta cor-receita">Entrou</span><b class="tabular">@Moeda(Model.TotalReceitas)</b></p>
            <p class="total"><span class="legenda-solta cor-despesa">Saiu</span><b class="tabular">@Moeda(Model.TotalDespesas)</b></p>
            @if (Model.TotalInvestimentos > 0)
            {
                <p class="total"><span class="legenda-solta cor-investimento">Investido</span><b class="tabular">@Moeda(Model.TotalInvestimentos)</b></p>
            }
        </div>

        @foreach (var dia in dias)
        {
            <section class="dia" data-grupo-busca>
                <h2 class="dia-titulo"><span>@NomeDoDia(dia.Key)</span><span class="tabular">@TotalDoDia(dia)</span></h2>
                <div class="lista">
                    @foreach (var transacao in dia)
                    {
                        <button type="button" class="lista-item" data-linha-busca data-editar="gaveta-transacao"
                                data-titulo="Editar lançamento" data-acao="@Url.Action("Alterar", new { codigo = transacao.Codigo })"
                                data-excluir="@Url.Action("Inativar", new { codigo = transacao.Codigo })"
                                data-descricao="@(transacao.Descricao ?? transacao.NomeCategoria)" data-valores="@ValoresDe(transacao)">
                            <span class="icone-quadro icone-tipo @transacao.Tipo.ClasseCor()"><icone nome="@transacao.Tipo.Icone()" /></span>
                            <span class="lista-item-corpo">
                                <span class="lista-item-titulo">@(string.IsNullOrWhiteSpace(transacao.Descricao) ? transacao.NomeCategoria : transacao.Descricao)</span>
                                <span class="lista-item-detalhe">
                                    @transacao.NomeCategoria
                                    @if (transacao.Recorrente)
                                    {
                                        <span class="selo"><icone nome="repetir" />todo mês</span>
                                    }
                                </span>
                            </span>
                            <span class="valor tabular @transacao.Tipo.ClasseTexto()">@transacao.Tipo.Sinal()@Moeda(transacao.Valor)</span>
                        </button>
                    }
                </div>
            </section>
        }

        <p class="estado-vazio" data-busca-vazia hidden><icone nome="lupa" />Nada encontrado com essa busca.</p>

        <partial name="_Paginacao" model="@(new PaginacaoViewModel
                                         {
                                             PaginaAtual = Model.Pagina.PaginaAtual,
                                             TotalPaginas = Model.Pagina.TotalPaginas,
                                             ValoresRota = Model.FiltroRota.ParaValoresRota(),
                                         })" />
    }
    else if (!Model.Categorias.Any())
    {
        <div class="estado-vazio">
            <icone nome="categorias" />
            <p>Crie uma categoria primeiro, para saber onde cada lançamento entra.</p>
            <a class="botao botao-escuro" asp-controller="Categoria" asp-action="Index">Ir para categorias</a>
        </div>
    }
    else
    {
        <div class="estado-vazio">
            <icone nome="transacoes" />
            <p>Nenhum lançamento em @nomeMes.</p>
            <button type="button" class="botao botao-primario" data-editar="gaveta-transacao" data-titulo="Novo lançamento"
                    data-acao="@Url.Action("Criar")" data-valores="@ValoresDaNova()">Lançar o primeiro</button>
        </div>
    }
</main>

@if (Model.Categorias.Any())
{
    <dialog class="gaveta" id="gaveta-transacao" aria-labelledby="gaveta-transacao-titulo">
        <form method="post" asp-action="Criar" class="gaveta-corpo" data-formulario-gaveta>
            <partial name="_CamposFiltro" model="Model.FiltroRota" />

            <div class="gaveta-topo">
                <h2 class="gaveta-titulo" id="gaveta-transacao-titulo" data-titulo-gaveta>Novo lançamento</h2>
                <button type="button" class="botao botao-icone botao-icone-plano" data-fechar aria-label="Fechar"><icone nome="fechar" /></button>
            </div>

            <div class="segmentado segmentado-bloco" role="radiogroup" aria-label="Tipo">
                @foreach (var tipo in tiposTransacao)
                {
                    <label class="tipo-@tipo.ToString().ToLower()">
                        <input type="radio" name="Tipo" value="@tipo" checked="@(tipo == TipoTransacaoEnum.DESPESA)" data-filtro-tipo />@tipo.RotuloTela()
                    </label>
                }
            </div>

            <label class="campo-valor">
                <span class="campo-rotulo">Valor</span>
                <span class="campo-valor-linha">
                    <span class="campo-valor-moeda">R$</span>
                    <input type="text" name="Valor" inputmode="decimal" placeholder="0,00" autocomplete="off" required data-campo-decimal />
                </span>
            </label>

            <div class="campo">
                <label for="transacao-descricao">Descrição</label>
                <input id="transacao-descricao" type="text" name="Descricao" class="entrada" maxlength="200" placeholder="Opcional, ex.: mercado do mês" />
            </div>

            <div class="campo">
                <label for="transacao-categoria">Categoria</label>
                <select id="transacao-categoria" name="CodigoCategoria" class="entrada" required data-filtro-categoria>
                    @foreach (var tipo in tiposTransacao)
                    {
                        var categoriasDoTipo = Model.Categorias.Where(categoria => categoria.Tipo == tipo).ToList();
                        if (categoriasDoTipo.Count > 0)
                        {
                            <optgroup label="@tipo.Rotulo()" data-tipo-grupo="@tipo">
                                @foreach (var categoria in categoriasDoTipo)
                                {
                                    <option value="@categoria.Codigo">@categoria.Nome</option>
                                }
                            </optgroup>
                        }
                    }
                </select>
            </div>

            <div class="grade gaveta-par">
                <div class="campo">
                    <label for="transacao-data">Data</label>
                    <input id="transacao-data" type="date" name="Data" class="entrada" required />
                </div>
                <label class="interruptor">
                    <span>Todo mês</span>
                    <input type="checkbox" name="Recorrente" value="true" />
                </label>
            </div>

            <button type="submit" class="botao botao-primario botao-grande botao-bloco">Salvar</button>
            <button type="button" class="botao botao-contorno botao-bloco texto-erro" data-abrir-excluir hidden><icone nome="lixeira" />Excluir lançamento</button>
        </form>
    </dialog>

    <dialog class="gaveta gaveta-pequena" id="gaveta-excluir" aria-labelledby="gaveta-excluir-titulo">
        <form method="post" asp-action="Inativar" class="gaveta-corpo" data-formulario-excluir>
            <partial name="_CamposFiltro" model="Model.FiltroRota" />
            <h2 class="gaveta-titulo" id="gaveta-excluir-titulo">Excluir lançamento?</h2>
            <p class="texto-suave" data-descricao-excluir></p>
            <div class="grade gaveta-par">
                <button type="button" class="botao botao-contorno" data-fechar>Cancelar</button>
                <button type="submit" class="botao botao-perigo">Excluir</button>
            </div>
        </form>
    </dialog>
}
