@inject IConfiguration Configuracao
@{
    var logado = User.Identity?.IsAuthenticated == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var urlCanonica = SeoUrls.Canonica(Context.Request);
    var urlImagemSocial = SeoUrls.Absoluta(Context.Request, "/og-image-finance.png");
    var titulo = ViewData["Title"] is string tituloPagina ? $"{tituloPagina} · lawllit.finance" : "lawllit.finance";

    string? Atual(string nome) => controller == nome ? "page" : null;
}
<!DOCTYPE html>
@* Logado, o tema vem da conta e o tema.js não mexe. Fora da conta, segue o aparelho como o lawllit.com. *@
<html lang="pt-BR" data-tema="@(logado ? Aparencia.Tema(User) : null)" data-tema-conta="@(logado ? "" : null)"
      data-tamanho-fonte="@(logado ? Aparencia.TamanhoFonte(User) : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@titulo</title>
    <meta name="description" content="Suas finanças. Simples assim." />
    <link rel="canonical" href="@urlCanonica" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="lawllit.finance" />
    <meta property="og:title" content="lawllit.finance" />
    <meta property="og:description" content="Suas finanças. Simples assim." />
    <meta property="og:url" content="@urlCanonica" />
    <meta property="og:image" content="@urlImagemSocial" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="lawllit.finance" />
    <meta name="twitter:description" content="Suas finanças. Simples assim." />
    <meta name="twitter:image" content="@urlImagemSocial" />
    <partial name="_RecursosLawllit" />
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
</head>
<body data-url-entrar="@Url.Action("Entrar", "Conta")">
    <header class="topo">
        <div class="conteiner topo-linha">
            <a class="marca" asp-controller="@(logado ? "Painel" : "Inicio")" asp-action="Index">lawllit<span class="marca-ponto">.</span><span class="marca-sufixo">finance</span></a>

            @if (logado)
            {
                <nav class="menu-pilula so-computador" aria-label="Menu do finance">
                    <a asp-controller="Painel" asp-action="Index" aria-current="@Atual("Painel")">Painel</a>
                    <a asp-controller="Transacao" asp-action="Index" aria-current="@Atual("Transacao")">Transações</a>
                    <a asp-controller="Categoria" asp-action="Index" aria-current="@Atual("Categoria")">Categorias</a>
                    <a asp-controller="Cotacoes" asp-action="Index" aria-current="@Atual("Cotacoes")">Cotações</a>
                </nav>
            }

            <div class="topo-acoes">
                <button type="button" class="botao botao-icone" data-alternar-tema aria-label="Trocar entre tema claro e escuro">
                    <icone nome="lua" class="icone-lua" />
                    <icone nome="sol" class="icone-sol" />
                </button>

                @if (logado)
                {
                    <a class="botao botao-icone" asp-controller="Perfil" asp-action="Index" aria-label="Perfil"
                       aria-current="@Atual("Perfil")">
                        <icone nome="perfil" />
                    </a>
                    <form asp-controller="Conta" asp-action="Sair" method="post">
                        <button type="submit" class="botao botao-icone" aria-label="Sair"><icone nome="sair" /></button>
                    </form>
                }
                else if (controller != "Conta")
                {
                    <a class="botao botao-escuro" asp-controller="Conta" asp-action="Entrar">Entrar</a>
                }
            </div>
        </div>
    </header>

    <partial name="_Notificacao" />

    @RenderBody()

    <footer class="rodape">
        <div class="conteiner">
            <div class="rodape-conteudo">
                <div class="rodape-marca">
                    <a class="marca marca-rodape" href="@Configuracao["Site:Url"]">lawllit<span class="marca-ponto">.</span><span class="marca-sufixo">finance</span></a>
                    <p>Suas finanças. Simples assim.</p>
                    <p class="rodape-direitos">© @HorarioBrasil.Agora.Year lawllit.</p>
                </div>
                <nav class="rodape-grupo rodape-grupo-linha" aria-label="Rodapé">
                    <a asp-controller="Legal" asp-action="Privacidade">Privacidade</a>
                    <a asp-controller="Legal" asp-action="Termos">Termos de uso</a>
                    <a href="@Configuracao["Site:Url"]">lawllit.com</a>
                </nav>
            </div>
        </div>
    </footer>

    @if (logado)
    {
        <nav class="barra-inferior so-celular" aria-label="Menu do finance">
            <a asp-controller="Painel" asp-action="Index" aria-current="@Atual("Painel")"><icone nome="painel" />Painel</a>
            <a asp-controller="Transacao" asp-action="Index" aria-current="@Atual("Transacao")"><icone nome="transacoes" />Transações</a>
            @* Fora da tela de transações o + leva até ela com a gaveta já aberta. *@
            <a class="botao-flutuante" asp-controller="Transacao" asp-action="Index" asp-route-novo="true" aria-label="Lançar transação"
               data-nova-transacao><icone nome="mais" /></a>
            <a asp-controller="Categoria" asp-action="Index" aria-current="@Atual("Categoria")"><icone nome="categorias" />Categorias</a>
            <a asp-controller="Cotacoes" asp-action="Index" aria-current="@Atual("Cotacoes")"><icone nome="cotacoes" />Cotações</a>
        </nav>

        <form id="form-preferencia" asp-controller="Perfil" asp-action="SalvarPreferencia" method="post" hidden></form>
    }

    <script src="~/_content/Lawllit.Web/js/lawllit.js" asp-append-version="true" defer></script>
    <script src="~/js/finance.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
