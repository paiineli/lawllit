@model PaginacaoViewModel
@{
    if (Model.TotalPaginas <= 1) { return; }

    var acaoAtual = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    // Janela de no máximo cinco páginas em volta da atual, para o rodapé não crescer sem fim.
    const int tamanhoJanela = 5;
    var primeiraPagina = Math.Max(1, Model.PaginaAtual - tamanhoJanela / 2);
    var ultimaPagina = Math.Min(Model.TotalPaginas, primeiraPagina + tamanhoJanela - 1);
    primeiraPagina = Math.Max(1, ultimaPagina - tamanhoJanela + 1);

    string UrlDaPagina(int numeroPagina)
    {
        var valoresRota = new Dictionary<string, object?>(Model.ValoresRota) { ["pagina"] = numeroPagina };
        return Url.Action(acaoAtual, valoresRota)!;
    }
}

<nav class="paginacao" aria-label="Páginas">
    @if (Model.PaginaAtual > 1)
    {
        <a href="@UrlDaPagina(Model.PaginaAtual - 1)" aria-label="Página anterior"><icone nome="chevron-esquerda" /></a>
    }

    @for (var numeroPagina = primeiraPagina; numeroPagina <= ultimaPagina; numeroPagina++)
    {
        <a href="@UrlDaPagina(numeroPagina)" aria-current="@(numeroPagina == Model.PaginaAtual ? "page" : null)">@numeroPagina</a>
    }

    @if (Model.PaginaAtual < Model.TotalPaginas)
    {
        <a href="@UrlDaPagina(Model.PaginaAtual + 1)" aria-label="Próxima página"><icone nome="chevron-direita" /></a>
    }
</nav>
