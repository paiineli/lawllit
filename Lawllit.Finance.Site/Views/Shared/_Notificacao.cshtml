@* Mensagem do redirect depois de um POST. Sai sozinha pelo lawllit.js, como os avisos criados em JS. *@
@if (TempData["Sucesso"] is string mensagemSucesso)
{
    <div class="avisos" role="status" aria-live="polite">
        <div class="aviso aviso-ok"><icone nome="check" /><span>@mensagemSucesso</span></div>
    </div>
}
else if (TempData["Erro"] is string mensagemErro)
{
    <div class="avisos" role="alert">
        <div class="aviso aviso-erro"><icone nome="alerta" /><span>@mensagemErro</span></div>
    </div>
}
