@model List<CotacaoModel>
@{
    ViewData["Title"] = "Cotações";
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
}

<main class="conteiner pagina">
    <div class="linha-espacada">
        <div>
            <p class="texto-pequeno texto-suave">Quanto vale cada moeda em real, agora</p>
            <h1 class="titulo-grande">Cotações</h1>
        </div>
        <a asp-action="Index" class="botao botao-contorno"><icone nome="atualizar" />Atualizar</a>
    </div>

    @if (!Model.Any())
    {
        <div class="estado-vazio">
            <icone nome="alerta" />
            <p>Não deu para carregar as cotações agora.</p>
            <p class="texto-pequeno">Tente de novo em alguns minutos.</p>
        </div>
    }
    else
    {
        <div class="grade cotacoes">
            @foreach (var cotacao in Model)
            {
                var formato = "F" + cotacao.CasasDecimais;
                var subiu = cotacao.VariacaoPercentual >= 0;
                <section class="cartao cotacao">
                    <div class="linha-espacada">
                        <p class="cotacao-moeda"><span class="cotacao-bandeira" aria-hidden="true">@cotacao.Bandeira</span>@cotacao.Rotulo</p>
                        <span class="selo @(subiu ? "selo-ok" : "selo-erro")">
                            <icone nome="@(subiu ? "grafico-sobe" : "grafico-desce")" />@((subiu ? "+" : "") + cotacao.VariacaoPercentual.ToString("F2", cultura))%
                        </span>
                    </div>
                    <p class="numero cotacao-valor">R$ @cotacao.ValorCompra.ToString(formato, cultura)</p>
                    <div class="linha texto-pequeno texto-suave tabular">
                        <span>Máxima @cotacao.MaximaDia.ToString(formato, cultura)</span>
                        <span>Mínima @cotacao.MinimaDia.ToString(formato, cultura)</span>
                    </div>
                    <p class="texto-pequeno texto-suave">Atualizado @cotacao.AtualizadoEm.ToString("dd/MM 'às' HH:mm", cultura)</p>
                </section>
            }
        </div>
    }
</main>
