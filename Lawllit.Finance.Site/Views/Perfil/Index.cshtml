@model PerfilViewModel
@{
    ViewData["Title"] = "Perfil";

    var abas = new (string Chave, string? Rota, string Rotulo)[]
    {
        ("info", null, "Geral"),
        ("seguranca", "seguranca", "Segurança"),
        ("aparencia", "aparencia", "Preferências"),
        ("conta", "conta", "Conta"),
    };

    var temas = new (string Valor, string Rotulo)[] { ("light", "Claro"), ("dark", "Escuro"), ("high-contrast", "Alto contraste") };
    var tamanhos = new (string Valor, string Rotulo)[] { ("normal", "Normal"), ("large", "Grande"), ("xlarge", "Muito grande") };
}

<main class="conteiner conteiner-estreito pagina">
    <section class="perfil-cabecalho">
        <span class="perfil-avatar" aria-hidden="true">@Model.Nome[..1].ToUpper()</span>
        <div>
            <h1 class="titulo-grande">@Model.Nome</h1>
            <p class="texto-suave">@Model.Email · desde @Model.MembroDesdeTexto</p>
        </div>
    </section>

    <nav class="chips chips-par" aria-label="Seções do perfil">
        @foreach (var aba in abas)
        {
            <a class="chip" asp-action="Index" asp-route-aba="@aba.Rota" aria-current="@(Model.AbaAtiva == aba.Chave ? "page" : null)">@aba.Rotulo</a>
        }
    </nav>

    @if (Model.AbaAtiva == "info")
    {
        <section class="cartao perfil-secao">
            <h2 class="titulo-cartao">Como quer ser chamado</h2>
            <form method="post" asp-action="AlterarNome" class="pilha">
                <div class="campo">
                    <label for="perfil-nome">Nome</label>
                    <input id="perfil-nome" type="text" name="Nome" value="@Model.Nome" class="entrada" maxlength="100" required autocomplete="name" />
                </div>
                <button type="submit" class="botao botao-escuro">Salvar</button>
            </form>
        </section>
    }

    @if (Model.AbaAtiva == "seguranca")
    {
        <section class="cartao perfil-secao">
            <h2 class="titulo-cartao">E-mail</h2>
            <form method="post" asp-action="AlterarEmail" class="pilha">
                <div class="campo">
                    <label for="perfil-email">Endereço de e-mail</label>
                    <input id="perfil-email" type="email" name="Email" value="@Model.Email" class="entrada" required autocomplete="email" />
                </div>
                <div class="campo">
                    <label for="senha-email">Sua senha, para confirmar</label>
                    <partial name="_CampoSenha" model="@(new CampoSenhaViewModel("Senha", "senha-email", "current-password"))" />
                </div>
                <button type="submit" class="botao botao-escuro">Salvar e-mail</button>
            </form>
        </section>

        <section class="cartao perfil-secao">
            <h2 class="titulo-cartao">Senha</h2>
            <form method="post" asp-action="AlterarSenha" class="pilha">
                <div class="campo">
                    <label for="senha-atual">Senha atual</label>
                    <partial name="_CampoSenha" model="@(new CampoSenhaViewModel("SenhaAtual", "senha-atual", "current-password"))" />
                </div>
                <div class="campo">
                    <label for="senha-nova">Nova senha</label>
                    <partial name="_CampoSenha" model="@(new CampoSenhaViewModel("NovaSenha", "senha-nova", "new-password", "Mínimo 6 caracteres"))" />
                </div>
                <div class="campo">
                    <label for="senha-confirmar">Confirmar nova senha</label>
                    <partial name="_CampoSenha" model="@(new CampoSenhaViewModel("ConfirmarNovaSenha", "senha-confirmar", "new-password"))" />
                </div>
                <button type="submit" class="botao botao-escuro">Trocar senha</button>
            </form>
        </section>
    }

    @if (Model.AbaAtiva == "aparencia")
    {
        @* Grava na hora, sem botão de salvar. O valor enviado é o que o banco guarda. *@
        <section class="cartao perfil-secao">
            <h2 class="titulo-cartao">Tema</h2>
            <div class="chips" role="radiogroup" aria-label="Tema">
                @foreach (var tema in temas)
                {
                    <button type="button" class="chip" data-preferencia="tema" data-valor="@tema.Valor"
                            aria-pressed="@(Model.Tema == tema.Valor ? "true" : "false")">@tema.Rotulo</button>
                }
            </div>
        </section>

        <section class="cartao perfil-secao">
            <h2 class="titulo-cartao">Tamanho do texto</h2>
            <div class="chips" role="radiogroup" aria-label="Tamanho do texto">
                @foreach (var tamanho in tamanhos)
                {
                    <button type="button" class="chip" data-preferencia="tamanhoFonte" data-valor="@tamanho.Valor"
                            aria-pressed="@(Model.TamanhoFonte == tamanho.Valor ? "true" : "false")">@tamanho.Rotulo</button>
                }
            </div>
        </section>
    }

    @if (Model.AbaAtiva == "conta")
    {
        <section class="cartao perfil-secao perfil-perigo">
            <h2 class="titulo-cartao">Excluir conta</h2>
            <p class="texto-suave">Apaga de verdade a conta, as categorias e todos os lançamentos. Não tem como desfazer.</p>
            <button type="button" class="botao botao-contorno texto-erro" data-abrir="gaveta-excluir-conta"><icone nome="lixeira" />Excluir minha conta</button>
        </section>
    }
</main>

<dialog class="gaveta gaveta-pequena" id="gaveta-excluir-conta" aria-labelledby="gaveta-excluir-conta-titulo">
    <form method="post" asp-action="ExcluirConta" class="gaveta-corpo">
        <h2 class="gaveta-titulo" id="gaveta-excluir-conta-titulo">Excluir sua conta?</h2>
        <p class="texto-suave">Todos os lançamentos, categorias e dados da conta somem para sempre.</p>
        <div class="campo">
            <label for="senha-excluir">Sua senha, para confirmar</label>
            <partial name="_CampoSenha" model="@(new CampoSenhaViewModel("Senha", "senha-excluir", "current-password"))" />
        </div>
        <div class="grade gaveta-par">
            <button type="button" class="botao botao-contorno" data-fechar>Cancelar</button>
            <button type="submit" class="botao botao-perigo">Excluir para sempre</button>
        </div>
    </form>
</dialog>
