@model CategoriaListaViewModel
@{
    ViewData["Title"] = "Categorias";

    var tipos = new[] { TipoTransacaoEnum.DESPESA, TipoTransacaoEnum.RECEITA, TipoTransacaoEnum.INVESTIMENTO };

    var filtros = new (string Rotulo, TipoTransacaoEnum? Tipo)[]
    {
        ("Todas", null),
        ("Despesas", TipoTransacaoEnum.DESPESA),
        ("Receitas", TipoTransacaoEnum.RECEITA),
        ("Investimentos", TipoTransacaoEnum.INVESTIMENTO),
    };

    var valoresDaNova = System.Text.Json.JsonSerializer.Serialize(new { Tipo = TipoTransacaoEnum.DESPESA.ToString() });

    string ValoresDe(CategoriaItemModel categoria)
        => System.Text.Json.JsonSerializer.Serialize(new { categoria.Nome, Tipo = categoria.Tipo.ToString() });
}

<main class="conteiner pagina">
    <div class="linha-espacada">
        <div>
            <p class="texto-pequeno texto-suave">@Model.Categorias.Count @(Model.Categorias.Count == 1 ? "categoria" : "categorias")</p>
            <h1 class="titulo-grande">Categorias</h1>
        </div>
        <button type="button" class="botao botao-primario" data-editar="gaveta-categoria" data-titulo="Nova categoria"
                data-acao="@Url.Action("Criar")" data-valores="@valoresDaNova"><icone nome="mais" />Nova categoria</button>
    </div>

    <div class="filtros">
        <form class="busca" method="get" asp-action="Index" role="search">
            <icone nome="lupa" />
            <input type="hidden" name="tipo" value="@Model.FiltroTipo" />
            <input type="search" name="busca" placeholder="Buscar" aria-label="Buscar categoria" value="@Model.FiltroBusca" data-busca-viva />
        </form>
        <nav class="chips chips-rolagem" aria-label="Filtrar por tipo">
            @foreach (var filtro in filtros)
            {
                <a class="chip" asp-action="Index" asp-route-tipo="@filtro.Tipo" asp-route-busca="@Model.FiltroBusca"
                   aria-current="@(Model.FiltroTipo == filtro.Tipo ? "page" : null)">@filtro.Rotulo</a>
            }
        </nav>
    </div>

    @if (Model.Categorias.Any())
    {
        <div class="lista" data-grupo-busca>
            @foreach (var categoria in Model.Categorias)
            {
                <button type="button" class="lista-item" data-linha-busca data-editar="gaveta-categoria" data-titulo="Editar categoria"
                        data-acao="@Url.Action("Alterar", new { codigo = categoria.Codigo })"
                        data-excluir="@Url.Action("Inativar", new { codigo = categoria.Codigo })"
                        data-descricao="@categoria.Nome" data-valores="@ValoresDe(categoria)">
                    <span class="icone-quadro icone-tipo @categoria.Tipo.ClasseCor()"><icone nome="@categoria.Tipo.Icone()" /></span>
                    <span class="lista-item-corpo"><span class="lista-item-titulo">@categoria.Nome</span></span>
                    <span class="selo">@categoria.Tipo.Rotulo()</span>
                    <icone nome="chevron-direita" class="texto-suave" />
                </button>
            }
        </div>

        <p class="estado-vazio" data-busca-vazia hidden><icone nome="lupa" />Nenhuma categoria com esse nome.</p>
    }
    else
    {
        <p class="estado-vazio"><icone nome="categorias" />Nenhuma categoria encontrada.</p>
    }
</main>

<dialog class="gaveta" id="gaveta-categoria" aria-labelledby="gaveta-categoria-titulo">
    <form method="post" asp-action="Criar" class="gaveta-corpo" data-formulario-gaveta>
        <div class="gaveta-topo">
            <h2 class="gaveta-titulo" id="gaveta-categoria-titulo" data-titulo-gaveta>Nova categoria</h2>
            <button type="button" class="botao botao-icone botao-icone-plano" data-fechar aria-label="Fechar"><icone nome="fechar" /></button>
        </div>

        <div class="campo">
            <label for="categoria-nome">Nome</label>
            <input id="categoria-nome" type="text" name="Nome" class="entrada" maxlength="100" required placeholder="Ex.: Mercado, Salário" />
        </div>

        <div class="campo">
            <span class="campo-rotulo" id="categoria-tipo">Tipo</span>
            <div class="segmentado segmentado-bloco" role="radiogroup" aria-labelledby="categoria-tipo">
                @foreach (var tipo in tipos)
                {
                    <label><input type="radio" name="Tipo" value="@tipo" checked="@(tipo == TipoTransacaoEnum.DESPESA)" />@tipo.Rotulo()</label>
                }
            </div>
        </div>

        <button type="submit" class="botao botao-primario botao-grande botao-bloco">Salvar</button>
        <button type="button" class="botao botao-contorno botao-bloco texto-erro" data-abrir-excluir hidden><icone nome="lixeira" />Excluir categoria</button>
    </form>
</dialog>

<dialog class="gaveta gaveta-pequena" id="gaveta-excluir" aria-labelledby="gaveta-excluir-titulo">
    <form method="post" asp-action="Inativar" class="gaveta-corpo" data-formulario-excluir>
        <h2 class="gaveta-titulo" id="gaveta-excluir-titulo">Excluir categoria?</h2>
        <p class="texto-suave" data-descricao-excluir></p>
        <p class="texto-pequeno texto-suave">Os lançamentos antigos dela continuam no histórico.</p>
        <div class="grade gaveta-par">
            <button type="button" class="botao botao-contorno" data-fechar>Cancelar</button>
            <button type="submit" class="botao botao-perigo">Excluir</button>
        </div>
    </form>
</dialog>
