@model PainelModel
@{
    ViewData["Title"] = "Painel";

    // O app é em real, então a formatação é sempre pt-BR, independente do idioma da interface.
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var invariante = System.Globalization.CultureInfo.InvariantCulture;
    var nomesMeses = cultura.DateTimeFormat.MonthNames;

    var modoAno = Model.Periodo == PeriodoPainelEnum.ANO;
    var titulo = modoAno ? Model.Ano.ToString() : Maiuscula(nomesMeses[Model.Mes - 1]);
    var subtitulo = modoAno ? "Painel do ano" : $"Painel de {Model.Ano}";
    var contraAnterior = modoAno ? "vs. ano anterior" : "vs. mês anterior";
    var rotuloSaldo = Model.Saldo >= 0 ? (modoAno ? "Sobrou este ano" : "Sobrou este mês") : (modoAno ? "Faltou este ano" : "Faltou este mês");

    string Moeda(decimal valor) => valor.ToString("C", cultura);
    string Medida(decimal parte, decimal todo) => todo > 0 ? Math.Round(parte / todo * 100).ToString(invariante) : "0";

    // Despesa subindo é ruim e receita subindo é boa, então a cor e a seta saem do que o número
    // significa, e não do sinal. A seta garante que a leitura não dependa só da cor.
    (string Texto, string Classe)? Variacao(decimal? variacao, bool maisEhMelhor)
    {
        if (!variacao.HasValue) return null;
        var valor = variacao.Value;
        var seta = valor > 0 ? "▲" : valor < 0 ? "▼" : "=";
        var classe = valor == 0 ? "texto-suave" : (valor > 0) == maisEhMelhor ? "texto-ok" : "texto-erro";
        return ($"{seta} {Math.Abs(valor).ToString("F0", cultura)}%", classe);
    }

    var kpis = new[]
    {
        (Rotulo: "Entrou", Cor: "cor-receita", Valor: Model.TotalReceitas, Variacao: Variacao(Model.VariacaoReceitas, true)),
        (Rotulo: "Saiu", Cor: "cor-despesa", Valor: Model.TotalDespesas, Variacao: Variacao(Model.VariacaoDespesas, false)),
        (Rotulo: "Investido", Cor: "cor-investimento", Valor: Model.TotalInvestimentos, Variacao: Variacao(Model.VariacaoInvestimentos, true)),
    };

    // A maior barra do gráfico ocupa a altura toda, e as outras ficam proporcionais a ela.
    var maiorDoGrafico = Model.TendenciaMensal
        .SelectMany(mes => new[] { mes.Receitas, mes.Despesas, mes.Investimentos })
        .DefaultIfEmpty(0)
        .Max();

    var maiorCategoria = Model.DespesasPorCategoria.Select(categoria => categoria.Total).DefaultIfEmpty(0).Max();

    // Linha zerada fica de fora, senão quase todo mês sobraria um "aporte variável" de R$ 0,00.
    var linhasSaida = new[]
    {
        (Rotulo: "Custo fixo", Valor: Model.DespesasRecorrentes, Cor: "cor-despesa"),
        (Rotulo: "Custo variável", Valor: Model.DespesasVariaveis, Cor: "cor-despesa"),
        (Rotulo: "Aporte fixo", Valor: Model.InvestimentosRecorrentes, Cor: "cor-investimento"),
        (Rotulo: "Aporte variável", Valor: Model.InvestimentosVariaveis, Cor: "cor-investimento"),
    }.Where(linha => linha.Valor > 0).ToArray();
}

<main class="conteiner pagina">
    <div class="linha-espacada">
        <div class="periodo">
            <a class="botao botao-icone botao-icone-plano" asp-action="Index" asp-route-periodo="@Model.Periodo"
               asp-route-mes="@Model.MesAnterior" asp-route-ano="@Model.AnoAnterior"
               aria-label="@(modoAno ? "Ano anterior" : "Mês anterior")"><icone nome="chevron-esquerda" /></a>
            <div>
                <p class="texto-pequeno texto-suave">@subtitulo</p>
                <h1 class="titulo-grande">@titulo</h1>
            </div>
            @if (Model.PodeAvancar)
            {
                <a class="botao botao-icone botao-icone-plano" asp-action="Index" asp-route-periodo="@Model.Periodo"
                   asp-route-mes="@Model.ProximoMes" asp-route-ano="@Model.ProximoAno"
                   aria-label="@(modoAno ? "Próximo ano" : "Próximo mês")"><icone nome="chevron-direita" /></a>
            }
        </div>

        <nav class="segmentado" aria-label="Período">
            <a asp-action="Index" asp-route-periodo="@PeriodoPainelEnum.MES" asp-route-mes="@(modoAno ? HorarioBrasil.Agora.Month : Model.Mes)"
               asp-route-ano="@Model.Ano" aria-current="@(modoAno ? null : "page")">Mês</a>
            <a asp-action="Index" asp-route-periodo="@PeriodoPainelEnum.ANO" asp-route-ano="@Model.Ano"
               aria-current="@(modoAno ? "page" : null)">Ano</a>
        </nav>
    </div>

    <div class="painel-topo">
        <section class="cartao cartao-destaque painel-saldo">
            <p class="painel-saldo-rotulo">@rotuloSaldo</p>
            <div>
                <p class="numero painel-saldo-valor">@Moeda(Math.Abs(Model.Saldo))</p>
                @if (Model.TaxaPoupanca is decimal taxa && taxa > 0)
                {
                    <p class="painel-saldo-detalhe">@taxa.ToString("F0", cultura)% do que entrou</p>
                }
            </div>
        </section>

        <div class="painel-kpis">
            @foreach (var kpi in kpis)
            {
                <section class="cartao painel-kpi">
                    <p class="legenda-solta @kpi.Cor">@kpi.Rotulo</p>
                    <p class="numero painel-kpi-valor">@Moeda(kpi.Valor)</p>
                    @if (kpi.Variacao is { } variacao)
                    {
                        <p class="texto-pequeno"><b class="@variacao.Classe">@variacao.Texto</b> <span class="texto-suave">@contraAnterior</span></p>
                    }
                </section>
            }
        </div>
    </div>

    <div class="painel-meio">
        <section class="cartao cartao-invertido painel-ranking">
            <h2 class="titulo-cartao">Para onde foi</h2>
            <p class="texto-pequeno texto-suave">As maiores despesas contra a média de @Model.MesesDeReferencia meses</p>

            @if (Model.DespesasPorCategoria.Any())
            {
                <ol class="ranking">
                    @foreach (var categoria in Model.DespesasPorCategoria)
                    {
                        var participacao = Model.TotalRanking > 0 ? categoria.Total / Model.TotalRanking * 100 : 0;
                        <li class="ranking-item">
                            <span class="ranking-percentual">@participacao.ToString("F0", cultura)%</span>
                            <span class="ranking-corpo">
                                <span class="ranking-linha">
                                    <span class="ranking-nome">@categoria.NomeCategoria</span>
                                    <span class="tabular">@Moeda(categoria.Total)</span>
                                </span>
                                <span class="barra-trilho"><span class="barra-preenchimento" data-largura="@Medida(categoria.Total, maiorCategoria)"></span></span>
                            </span>
                            @if (Variacao(categoria.VariacaoPercentual, false) is { } variacao)
                            {
                                <span class="ranking-variacao @variacao.Classe">@variacao.Texto</span>
                            }
                            else
                            {
                                <span class="ranking-variacao texto-suave">novo</span>
                            }
                        </li>
                    }
                </ol>
            }
            else
            {
                <p class="estado-vazio estado-vazio-invertido"><icone nome="sacola" />Nenhuma despesa neste período.</p>
            }
        </section>

        <section class="cartao painel-grafico">
            <div class="cartao-cabecalho">
                <h2 class="titulo-cartao">Últimos 6 meses</h2>
                <div class="linha">
                    <span class="legenda cor-receita">Entrou</span>
                    <span class="legenda cor-despesa">Saiu</span>
                    <span class="legenda cor-investimento">Investido</span>
                </div>
            </div>

            @if (maiorDoGrafico > 0)
            {
                <div class="grafico-colunas" role="img" aria-label="Entradas, saídas e investimentos dos últimos seis meses">
                    @foreach (var mes in Model.TendenciaMensal)
                    {
                        <div class="grafico-coluna">
                            <div class="grafico-barras">
                                <span class="grafico-barra cor-receita" data-altura="@Medida(mes.Receitas, maiorDoGrafico)" title="Entrou @Moeda(mes.Receitas)"></span>
                                <span class="grafico-barra cor-despesa" data-altura="@Medida(mes.Despesas, maiorDoGrafico)" title="Saiu @Moeda(mes.Despesas)"></span>
                                <span class="grafico-barra cor-investimento" data-altura="@Medida(mes.Investimentos, maiorDoGrafico)" title="Investido @Moeda(mes.Investimentos)"></span>
                            </div>
                            <span class="grafico-rotulo">@nomesMeses[mes.Mes - 1][..3]</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="estado-vazio"><icone nome="painel" />Ainda não há lançamentos para mostrar.</p>
            }
        </section>
    </div>

    <div class="painel-resumos">
        @if (modoAno)
        {
            <section class="cartao">
                <p class="texto-suave">Média por mês</p>
                <p class="numero painel-resumo-valor">@Moeda(Model.TotalDespesas / 12)</p>
                <p class="texto-pequeno texto-suave">Despesa do ano dividida por doze meses</p>
            </section>
        }
        else
        {
            <section class="cartao">
                <p class="texto-suave">Previsão do mês</p>
                @if (Model.ProjecaoMensal is decimal projecao)
                {
                    <p class="numero painel-resumo-valor">@Moeda(projecao)</p>
                    <p class="texto-pequeno texto-suave">No ritmo atual, com @Model.DiasDecorridos dias registrados</p>
                }
                else
                {
                    <p class="texto-pequeno texto-suave">Sem dados para prever ainda</p>
                }
            </section>

            <section class="cartao">
                <p class="texto-suave">Ainda vai sair</p>
                @if (Model.MesCorrente && Model.DespesasAVencer > 0)
                {
                    <p class="numero painel-resumo-valor">@Moeda(Model.DespesasAVencer)</p>
                    <p class="texto-pequeno texto-suave">Despesas com data mais para frente neste mês</p>
                }
                else
                {
                    <p class="texto-pequeno texto-suave">Nenhuma conta agendada</p>
                }
            </section>

            <section class="cartao">
                <p class="texto-suave">Por dia</p>
                <p class="numero painel-resumo-valor">@Moeda(Model.MediaDiaria)</p>
                <p class="texto-pequeno texto-suave">
                    @(Model.MesCorrente ? $"Em {Model.DiasDecorridos} de {Model.DiasNoMes} dias" : $"Nos {Model.DiasNoMes} dias do mês")
                </p>
            </section>
        }
    </div>

    <div class="painel-detalhes">
        <section class="cartao">
            <h2 class="titulo-cartao">Fixo e variável</h2>
            @if (linhasSaida.Length > 0)
            {
                <div class="pilha painel-saidas">
                    @foreach (var linha in linhasSaida)
                    {
                        <div>
                            <p class="ranking-linha">
                                <span>@linha.Rotulo</span>
                                <span class="tabular"><b>@Moeda(linha.Valor)</b> <span class="texto-suave">· @Model.ParcelaSaida(linha.Valor).ToString("F0", cultura)%</span></span>
                            </p>
                            <span class="barra-trilho"><span class="barra-preenchimento @linha.Cor" data-largura="@Medida(linha.Valor, Model.TotalSaidas)"></span></span>
                        </div>
                    }
                </div>
                @if (Model.ParcelaComprometida is decimal comprometida)
                {
                    <p class="texto-pequeno texto-suave">
                        @(Model.InvestimentosRecorrentes > 0 ? "Custo fixo e aporte fixo comprometem" : "O custo fixo compromete")
                        @comprometida.ToString("F0", cultura)% do que entra.
                    </p>
                }
            }
            else
            {
                <p class="estado-vazio"><icone nome="repetir" />Sem despesas nem aportes neste período.</p>
            }
        </section>

        <section class="cartao">
            <h2 class="titulo-cartao">Total investido</h2>
            @if (Model.TotalInvestido > 0)
            {
                <p class="numero painel-resumo-valor texto-investimento">@Moeda(Model.TotalInvestido)</p>
                <p class="texto-pequeno texto-suave">Somando tudo o que você guardou em @Model.MesesInvestidos meses.</p>
                @if (Model.MediaInvestidaPorMes is decimal media)
                {
                    <p class="texto-pequeno texto-suave">Média de @Moeda(media) por mês com aporte.</p>
                }
            }
            else
            {
                <p class="estado-vazio"><icone nome="cofre" />Nenhum aporte lançado ainda.</p>
            }
        </section>
    </div>
</main>

@functions {
    private static string Maiuscula(string texto) => texto.Length == 0 ? texto : char.ToUpper(texto[0]) + texto[1..];
}
