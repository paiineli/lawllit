@model EsqueciSenhaViewModel
@{
    ViewData["Title"] = "Esqueci minha senha";
}

<main class="conteiner acesso">
    <partial name="_Chamada" />

    <div class="cartao cartao-sombra acesso-cartao">
        <h2 class="titulo-grande">Esqueci minha senha</h2>
        <p class="texto-suave">Informe seu e-mail e enviamos um link para criar uma senha nova.</p>

        <form asp-action="EsqueciSenha" method="post" novalidate class="pilha">
            <div asp-validation-summary="ModelOnly" class="alerta alerta-erro"></div>

            <div class="campo">
                <label asp-for="Email">E-mail</label>
                <input asp-for="Email" class="entrada" placeholder="seu@@email.com" autocomplete="email" />
                <span asp-validation-for="Email" class="erro-campo"></span>
            </div>

            <button type="submit" class="botao botao-primario botao-grande botao-bloco">Enviar link</button>
        </form>

        <p class="acesso-rodape">Lembrou a senha? <a asp-action="Entrar">Entrar</a></p>
    </div>
</main>
