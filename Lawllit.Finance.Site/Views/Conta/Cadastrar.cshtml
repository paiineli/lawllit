@model CadastrarViewModel
@{
    Layout = "_LayoutAcesso";
    var classeResumo = ViewData.ModelState.IsValid ? "d-none" : "";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="text-center mb-4">
            <h1 class="fs-4 fw-bold mb-1">lawllit<span class="brand-dot">.</span><span class="brand-finance">finance</span></h1>
            <p class="text-secondary small mb-0">Gestão financeira pessoal.</p>
        </div>

        <div class="card">
            <div class="card-body p-4">
                <h5 class="fw-semibold mb-4">Criar conta</h5>

                <form asp-action="Cadastrar" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 @classeResumo"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label small">Nome <span class="text-danger">*</span></label>
                        <input asp-for="Nome" class="form-control" placeholder="Seu nome" autocomplete="name">
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small">E-mail <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" placeholder="seu@@email.com" autocomplete="email">
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Senha" class="form-label small">Senha <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="Senha" type="password" class="form-control" id="senha-cadastro"
                                   placeholder="Mínimo 6 caracteres" autocomplete="new-password">
                            <button class="btn btn-outline-secondary" type="button" data-ver-senha="senha-cadastro"
                                    tabindex="-1" aria-label="Mostrar senha">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="AceitouTermos" class="form-check-input" type="checkbox" id="aceitou-termos">
                            <label class="form-check-label small text-secondary" for="aceitou-termos">
                                Li e concordo com os
                                <a asp-controller="Legal" asp-action="Termos" target="_blank" class="text-green">Termos de Uso</a>
                                e a
                                <a asp-controller="Legal" asp-action="Privacidade" target="_blank" class="text-green">Política de Privacidade</a>
                                do lawllit.finance.
                            </label>
                        </div>
                        <span asp-validation-for="AceitouTermos" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Criar conta</button>
                </form>
                <p class="text-center text-secondary small mt-3 mb-0">
                    Já tem conta?
                    <a asp-action="Entrar" class="text-green">Entrar</a>
                </p>

            </div>
        </div>

    </div>
</div>
