@model CadastrarViewModel
@{
    ViewData["Title"] = "Criar conta";
}

<main class="conteiner acesso">
    <partial name="_Chamada" />

    <div class="cartao cartao-sombra acesso-cartao">
        <h2 class="titulo-grande">Criar conta</h2>
        <p class="texto-suave">De graça. A conta já nasce com dez categorias para você começar.</p>

        <form asp-action="Cadastrar" method="post" novalidate class="pilha">
            <div asp-validation-summary="ModelOnly" class="alerta alerta-erro"></div>

            <div class="campo">
                <label asp-for="Nome">Nome</label>
                <input asp-for="Nome" class="entrada" placeholder="Como quer ser chamado" autocomplete="name" />
                <span asp-validation-for="Nome" class="erro-campo"></span>
            </div>

            <div class="campo">
                <label asp-for="Email">E-mail</label>
                <input asp-for="Email" class="entrada" placeholder="seu@@email.com" autocomplete="email" />
                <span asp-validation-for="Email" class="erro-campo"></span>
            </div>

            <div class="campo">
                <label asp-for="Senha">Senha</label>
                <partial name="_CampoSenha" model="@(new CampoSenhaViewModel("Senha", "senha-cadastro", "new-password", "Mínimo 6 caracteres"))" />
                <span asp-validation-for="Senha" class="erro-campo"></span>
            </div>

            <label class="acesso-termos">
                <input asp-for="AceitouTermos" type="checkbox" />
                <span>
                    Li e concordo com os <a asp-controller="Legal" asp-action="Termos" target="_blank">Termos de Uso</a>
                    e a <a asp-controller="Legal" asp-action="Privacidade" target="_blank">Política de Privacidade</a>.
                </span>
            </label>
            <span asp-validation-for="AceitouTermos" class="erro-campo"></span>

            <button type="submit" class="botao botao-primario botao-grande botao-bloco">Criar conta</button>
        </form>

        <p class="acesso-rodape">Já tem conta? <a asp-action="Entrar">Entrar</a></p>
    </div>
</main>
