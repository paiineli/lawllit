@model RedefinirSenhaViewModel
@{
    ViewData["Title"] = "Nova senha";
}

<main class="conteiner acesso">
    <partial name="_Chamada" />

    <div class="cartao cartao-sombra acesso-cartao">
        <h2 class="titulo-grande">Nova senha</h2>

        <form asp-action="RedefinirSenha" method="post" novalidate class="pilha">
            <div asp-validation-summary="ModelOnly" class="alerta alerta-erro"></div>
            <input asp-for="Token" type="hidden" />

            <div class="campo">
                <label asp-for="Senha">Nova senha</label>
                <partial name="_CampoSenha" model="@(new CampoSenhaViewModel("Senha", "senha-nova", "new-password", "Mínimo 6 caracteres"))" />
                <span asp-validation-for="Senha" class="erro-campo"></span>
            </div>

            <div class="campo">
                <label asp-for="ConfirmarSenha">Confirmar nova senha</label>
                <partial name="_CampoSenha" model="@(new CampoSenhaViewModel("ConfirmarSenha", "senha-confirmar", "new-password", "Repita a senha"))" />
                <span asp-validation-for="ConfirmarSenha" class="erro-campo"></span>
            </div>

            <button type="submit" class="botao botao-primario botao-grande botao-bloco">Salvar senha</button>
        </form>
    </div>
</main>
