@model EntrarViewModel
@{
    Layout = "_LayoutAcesso";
    var classeResumo = ViewData.ModelState.IsValid ? "d-none" : "";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="text-center mb-4">
            <h1 class="fs-4 fw-bold mb-1">lawllit<span class="brand-dot">.</span><span class="brand-finance">finance</span></h1>
            <p class="text-secondary small mb-0">Gestão financeira pessoal.</p>
        </div>

        <div class="card">
            <div class="card-body p-4">
                <h5 class="fw-semibold mb-4">Entrar</h5>

                @if (TempData["Sucesso"] is string success)
                {
                    <div class="alert alert-success py-2 small mb-3">@success</div>
                }
                @if (TempData["Erro"] is string error)
                {
                    <div class="alert alert-danger py-2 small mb-3">@error</div>
                }

                <form asp-action="Entrar" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 @classeResumo"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small">E-mail</label>
                        <input asp-for="Email" class="form-control" placeholder="seu@@email.com" autocomplete="email">
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Senha" class="form-label small">Senha</label>
                        <div class="input-group">
                            <input asp-for="Senha" type="password" class="form-control" id="senha-login" placeholder="senha@@123"
                                   autocomplete="current-password">
                            <button class="btn btn-outline-secondary" type="button" data-ver-senha="senha-login"
                                    tabindex="-1" aria-label="Mostrar senha">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Entrar</button>

                    <p class="text-center mt-3 mb-0">
                        <a asp-action="EsqueciSenha" class="text-secondary small">Esqueci minha senha</a>
                    </p>
                </form>

                <p class="text-center text-secondary small mt-3 mb-0">
                    Não tem conta?
                    <a asp-action="Cadastrar" class="text-green">Criar conta</a>
                </p>

            </div>
        </div>

    </div>
</div>
