@model EntrarViewModel
@{
    ViewData["Title"] = "Entrar";
}

<main class="conteiner acesso">
    <partial name="_Chamada" />

    <div class="cartao cartao-sombra acesso-cartao">
        <h2 class="titulo-grande">Entrar</h2>

        <form asp-action="Entrar" method="post" novalidate class="pilha">
            <div asp-validation-summary="ModelOnly" class="alerta alerta-erro"></div>

            <div class="campo">
                <label asp-for="Email">E-mail</label>
                <input asp-for="Email" class="entrada" placeholder="seu@@email.com" autocomplete="email" />
                <span asp-validation-for="Email" class="erro-campo"></span>
            </div>

            <div class="campo">
                <label asp-for="Senha">Senha</label>
                <partial name="_CampoSenha" model="@(new CampoSenhaViewModel("Senha", "senha-login", "current-password"))" />
                <span asp-validation-for="Senha" class="erro-campo"></span>
            </div>

            <a asp-action="EsqueciSenha" class="acesso-link">Esqueci minha senha</a>

            <button type="submit" class="botao botao-primario botao-grande botao-bloco">Entrar</button>
        </form>

        <p class="acesso-rodape">Não tem conta? <a asp-action="Cadastrar">Criar conta</a></p>
    </div>
</main>
