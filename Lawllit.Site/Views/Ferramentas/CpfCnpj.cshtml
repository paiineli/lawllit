@{
    var ferramenta = Ferramentas.Por("CpfCnpj");
    ViewData["Title"] = $"{ferramenta.Nome} · lawllit.";
    ViewData["Descricao"] = ferramenta.Descricao;
}

@section Estilos {
    <link rel="stylesheet" href="~/css/ferramentas.css" asp-append-version="true" />
}

<main class="conteiner">
    <partial name="_Cabecalho" model="ferramenta" />

    <div class="ferramenta-corpo">
        <section class="cartao pilha painel">
            <h2 class="painel-titulo"><span class="painel-numero">1</span><label for="documento-entrada">Cole os números</label></h2>
            <textarea id="documento-entrada" class="entrada area-codigo" spellcheck="false" placeholder="Um CPF ou CNPJ por linha, com ou sem pontuação"></textarea>

            <div class="acoes">
                <button type="button" class="botao botao-primario" data-documento="validar"><icone nome="check" />Validar</button>
                <button type="button" class="botao botao-contorno" data-documento="formatar">Pôr pontuação</button>
                <button type="button" class="botao botao-contorno" data-documento="limpar">Tirar pontuação</button>
            </div>

            <div class="campo">
                <p class="campo-rotulo">Precisa de um número para teste?</p>
                <div class="acoes">
                    <button type="button" class="botao botao-contorno" data-documento="gerar-cpf"><icone nome="mais" />Gerar CPF</button>
                    <button type="button" class="botao botao-contorno" data-documento="gerar-cnpj"><icone nome="mais" />Gerar CNPJ</button>
                </div>
            </div>
        </section>

        <section class="cartao cartao-sombra pilha painel">
            <h2 class="painel-titulo"><span class="painel-numero">2</span><label for="documento-saida">Resultado</label></h2>
            <textarea id="documento-saida" class="entrada area-codigo" readonly spellcheck="false" placeholder="O resultado aparece aqui, na mesma ordem das linhas."
                      data-valido="Válido"
                      data-invalido="Inválido"></textarea>
            <div class="acoes">
                <button type="button" class="botao botao-escuro" data-copiar="#documento-saida"><icone nome="copiar" />Copiar resultado</button>
                <button type="button" id="documento-limpar" class="botao"><icone nome="lixeira" />Limpar</button>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script src="~/js/cpf-cnpj.js" asp-append-version="true"></script>
}
