@{
    var ferramenta = Ferramentas.Por("QrCode");
    ViewData["Title"] = $"{ferramenta.Nome} · lawllit.";
}

<main class="container-lg">
    <div class="util">
        <partial name="_Cabecalho" model="ferramenta" />

        <section class="util-painel">
            <p class="util-rotulo">// entrada</p>
            <textarea id="qr-entrada" class="util-area" placeholder="cole um texto ou link..."></textarea>
            <div class="util-acoes">
                <button id="qr-gerar" class="botao botao-cheio">gerar</button>
                <button id="qr-limpar" class="botao">limpar</button>
            </div>
        </section>

        <section class="util-painel">
            <p class="util-rotulo">// saída</p>
            <div class="util-qr" hidden>
                <div id="qr-desenho" class="util-qr-desenho"></div>
            </div>
            <div class="util-acoes">
                <button id="qr-baixar" class="botao" disabled>baixar png</button>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@@1.0.0/qrcode.min.js"></script>
    <script src="~/js/qr-code.js" asp-append-version="true"></script>
}
