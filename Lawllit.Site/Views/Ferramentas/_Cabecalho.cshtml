@model Ferramenta

<header>
    <a class="chip chip-pequeno" asp-controller="Ferramentas" asp-action="Index"><icone nome="chevron-esquerda" />Ferramentas</a>

    <div class="ferramenta-titulo">
        <span class="icone-quadro icone-quadro-cheio"><icone nome="@Model.Icone" /></span>
        <h1 class="titulo-grande">@Model.Nome</h1>
    </div>
    <p class="texto-grande texto-suave ferramenta-descricao">@Model.Descricao</p>
</header>
