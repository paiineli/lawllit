<main class="lp-main">
    <div class="shell">
        <div class="lp-body">

            <header class="lp-header">
                <p class="lp-section-title"><a asp-controller="Ferramentas" asp-action="Index">ferramentas.</a></p>
                <h1 class="lp-name">unificador de pdf</h1>
            </header>

            <section class="lp-section">
                <p class="lp-section-title">// como funciona</p>
                <ol class="tool-steps">
                    <li>envie seus arquivos pdf</li>
                    <li>as páginas são mescladas na ordem dos arquivos</li>
                    <li>baixe o pdf unificado</li>
                </ol>
            </section>

            <section class="lp-section">
                <p class="lp-section-title">// enviar</p>
                <form asp-controller="Ferramentas" asp-action="JuntarPdf" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="tool-upload-area">
                        <input type="file" id="files-input" name="files" multiple accept=".pdf" class="visually-hidden" />
                        <label for="files-input" class="tool-upload-label">
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>escolher arquivos</span>
                            <span class="lp-edu-meta">.pdf · páginas mescladas na ordem de envio</span>
                        </label>
                    </div>
                    <div id="file-list" class="tool-file-list" hidden></div>
                    <button type="submit" id="merge-btn" class="lp-btn" disabled>mesclar arquivos</button>
                </form>
            </section>

        </div>
    </div>
</main>

<div id="merge-overlay" class="merge-overlay" hidden>
    <p id="overlay-label" class="merge-overlay-label" data-molde="arquivo {0} de {1}"></p>
    <div class="merge-overlay-track">
        <div id="overlay-progress" class="merge-overlay-fill"></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
    <script src="~/js/juntar-pdf.js" asp-append-version="true"></script>
}
