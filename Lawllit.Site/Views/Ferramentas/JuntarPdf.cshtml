@{
    var ferramenta = Ferramentas.Por("JuntarPdf");
    ViewData["Title"] = $"{ferramenta.Nome} · lawllit.";
}

<main class="container-lg">
    <div class="util">
        <partial name="_Cabecalho" model="ferramenta" />

        <section class="util-painel">
            <p class="util-rotulo">// como funciona</p>
            <ol class="util-passos">
                <li>envie seus arquivos pdf</li>
                <li>as páginas são mescladas na ordem dos arquivos</li>
                <li>baixe o pdf unificado</li>
            </ol>
        </section>

        <section class="util-painel">
            <p class="util-rotulo">// enviar</p>
            <form asp-controller="Ferramentas" asp-action="JuntarPdf" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="util-envio">
                    <input type="file" id="arquivos-entrada" name="files" multiple accept=".pdf" class="fora-da-tela" />
                    <label for="arquivos-entrada" class="util-envio-rotulo">
                        <i class="bi bi-file-earmark-pdf"></i>
                        <span>escolher arquivos</span>
                        <span class="util-dica">.pdf · páginas mescladas na ordem de envio</span>
                    </label>
                </div>
                <div id="arquivos-lista" class="util-arquivos" hidden></div>
                <button type="submit" id="arquivos-unificar" class="botao botao-cheio" disabled>mesclar arquivos</button>
            </form>
        </section>
    </div>
</main>

<div id="progresso" class="util-progresso" hidden>
    <p id="progresso-rotulo" class="util-progresso-rotulo" data-molde="arquivo {0} de {1}"></p>
    <div class="util-progresso-trilho">
        <div id="progresso-barra" class="util-progresso-barra"></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/pdf-lib@@1.17.1/dist/pdf-lib.min.js"></script>
    <script src="~/js/juntar-pdf.js" asp-append-version="true"></script>
}
