@{
    var ferramenta = Ferramentas.Por("JuntarPdf");
    ViewData["Title"] = $"{ferramenta.Nome} · lawllit.";
    ViewData["Descricao"] = ferramenta.Descricao;
}

@section Estilos {
    <link rel="stylesheet" href="~/css/ferramentas.css" asp-append-version="true" />
}

<main class="conteiner ferramenta-pagina">
    <partial name="_Cabecalho" model="ferramenta" />

    <div class="ferramenta-corpo">
        <section class="cartao pilha painel">
            <h2 class="painel-titulo"><span class="painel-numero">1</span>Escolha os PDFs</h2>

            <form class="pilha" asp-controller="Ferramentas" asp-action="JuntarPdf" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <label class="envio" data-acumula>
                    <input type="file" id="arquivos-entrada" name="files" multiple accept=".pdf,application/pdf" />
                    <span class="envio-icone"><icone nome="upload" /></span>
                    <span class="titulo-cartao envio-titulo"><span class="so-celular">Toque para escolher</span><span class="so-computador">Clique ou arraste os PDFs aqui</span></span>
                    <span class="texto-pequeno texto-suave">Dois ou mais. Dá para escolher aos poucos. Eles não saem do seu aparelho.</span>
                </label>

                <ol id="arquivos-lista" class="lista arquivos" aria-label="Ordem dos arquivos" hidden></ol>

                <button type="submit" id="arquivos-unificar" class="botao botao-primario botao-grande botao-bloco" disabled><icone nome="download" />Juntar e baixar</button>
            </form>
        </section>

        <section class="cartao pilha painel">
            <h2 class="painel-titulo">Como funciona</h2>
            <ol class="passos">
                <li><span class="painel-numero">1</span><span>Escolha os PDFs, de uma vez ou aos poucos. O x tira um da lista.</span></li>
                <li><span class="painel-numero">2</span><span>As páginas são juntadas na ordem em que aparecem na lista.</span></li>
                <li><span class="painel-numero">3</span><span>O PDF único é baixado na hora.</span></li>
            </ol>
        </section>
    </div>
</main>

<div id="progresso" class="progresso" hidden>
    <div class="cartao pilha progresso-cartao" role="status" aria-live="polite">
        <p class="titulo-cartao">Juntando...</p>
        <p id="progresso-rotulo" class="texto-suave" data-molde="Arquivo {0} de {1}"></p>
        <div class="barra-trilho"><div id="progresso-barra" class="barra-preenchimento"></div></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/pdf-lib@@1.17.1/dist/pdf-lib.min.js"></script>
    <script src="~/js/envio.js" asp-append-version="true"></script>
    <script src="~/js/lista-arquivos.js" asp-append-version="true"></script>
    <script src="~/js/juntar-pdf.js" asp-append-version="true"></script>
}
