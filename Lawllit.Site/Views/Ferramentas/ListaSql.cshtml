@{
    var ferramenta = Ferramentas.Por("ListaSql");
    ViewData["Title"] = $"{ferramenta.Nome} · lawllit.";
    ViewData["Descricao"] = ferramenta.Descricao;
}

@section Estilos {
    <link rel="stylesheet" href="~/css/ferramentas.css" asp-append-version="true" />
}

<main class="conteiner ferramenta-pagina">
    <partial name="_Cabecalho" model="ferramenta" />

    <div class="ferramenta-corpo">
        <section class="cartao pilha painel">
            <h2 class="painel-titulo"><span class="painel-numero">1</span><label for="sql-entrada">Cole a lista</label></h2>
            <textarea id="sql-entrada" class="entrada area-codigo" spellcheck="false" placeholder="Um valor por linha"></textarea>

            <div class="grade opcoes">
                <label class="interruptor">
                    <span>Remover repetidos</span>
                    <input type="checkbox" id="sql-duplicados" />
                </label>
                <label class="interruptor">
                    <span>Colocar entre parênteses</span>
                    <input type="checkbox" id="sql-parenteses" checked />
                </label>
            </div>

            <div class="campo">
                <p class="campo-rotulo">Escolha o formato e pronto</p>
                <div class="acoes">
                    <button type="button" class="botao botao-primario" data-aspas="simples"><code>'a','b'</code></button>
                    <button type="button" class="botao botao-contorno" data-aspas="duplas"><code>"a","b"</code></button>
                    <button type="button" class="botao botao-contorno" data-aspas="nenhuma"><code>a,b</code></button>
                </div>
            </div>
        </section>

        <section class="cartao cartao-sombra pilha painel">
            <h2 class="painel-titulo"><span class="painel-numero">2</span><label for="sql-saida">Resultado</label></h2>
            <textarea id="sql-saida" class="entrada area-codigo" readonly spellcheck="false" placeholder="O resultado aparece aqui."></textarea>
            <div class="acoes">
                <button type="button" class="botao botao-escuro" data-copiar="#sql-saida"><icone nome="copiar" />Copiar resultado</button>
                <button type="button" id="sql-limpar" class="botao"><icone nome="lixeira" />Limpar</button>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script src="~/js/lista-sql.js" asp-append-version="true"></script>
}
