<main class="lp-main">
    <div class="shell">
        <div class="lp-body">

            <header class="lp-header">
                <p class="lp-section-title"><a asp-controller="Ferramentas" asp-action="Index">ferramentas.</a></p>
                <h1 class="lp-name">lista para sql</h1>
            </header>

            <section class="lp-section">
                <p class="lp-section-title">// entrada</p>
                <textarea id="sql-input" class="tool-textarea" placeholder="um valor por linha..."></textarea>
                <div class="tool-options">
                    <label class="tool-option">
                        <input type="checkbox" id="sql-dedupe" />
                        <span>remover duplicados</span>
                    </label>
                    <label class="tool-option">
                        <input type="checkbox" id="sql-parens" checked />
                        <span>envolver em ( )</span>
                    </label>
                </div>
                <div class="tool-actions">
                    <button class="lp-btn" data-aspas="simples">'x','y'</button>
                    <button class="lp-btn" data-aspas="duplas">"x","y"</button>
                    <button class="lp-btn" data-aspas="nenhuma">x,y</button>
                </div>
            </section>

            <section class="lp-section">
                <p class="lp-section-title">// saída</p>
                <textarea id="sql-output" class="tool-textarea" readonly></textarea>
                <div class="tool-actions">
                    <button id="sql-copy" class="lp-btn" data-copiar="#sql-output">copiar</button>
                    <button id="sql-clear" class="lp-btn">limpar</button>
                </div>
            </section>

        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/lista-sql.js" asp-append-version="true"></script>
}
