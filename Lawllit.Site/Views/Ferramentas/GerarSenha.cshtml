@{
    var ferramenta = Ferramentas.Por("GerarSenha");
    ViewData["Title"] = $"{ferramenta.Nome} · lawllit.";
    ViewData["Descricao"] = ferramenta.Descricao;
}

@section Estilos {
    <link rel="stylesheet" href="~/css/ferramentas.css" asp-append-version="true" />
}

<main class="conteiner">
    <partial name="_Cabecalho" model="ferramenta" />

    <div class="ferramenta-corpo">
        <section class="cartao pilha painel">
            <h2 class="painel-titulo"><span class="painel-numero">1</span>Escolha como ela vai ser</h2>

            <div class="campo">
                <div class="faixa-topo">
                    <label for="senha-tamanho">Tamanho</label>
                    <span><b id="senha-tamanho-valor" class="numero faixa-valor">16</b> <span class="texto-suave">caracteres</span></span>
                </div>
                <input type="range" id="senha-tamanho" class="faixa" min="4" max="64" step="1" value="16" />
            </div>

            <div class="grade opcoes">
                <label class="interruptor">
                    <span>Letras maiúsculas</span>
                    <input type="checkbox" id="senha-maiusculas" checked />
                </label>
                <label class="interruptor">
                    <span>Letras minúsculas</span>
                    <input type="checkbox" id="senha-minusculas" checked />
                </label>
                <label class="interruptor">
                    <span>Números</span>
                    <input type="checkbox" id="senha-numeros" checked />
                </label>
                <label class="interruptor">
                    <span>Símbolos como !@@#</span>
                    <input type="checkbox" id="senha-simbolos" checked />
                </label>
            </div>
        </section>

        <section class="cartao cartao-sombra pilha painel">
            <h2 class="painel-titulo"><span class="painel-numero">2</span><label for="senha-resultado">Sua senha</label></h2>

            <div class="senha-saida">
                <input type="text" id="senha-resultado" class="entrada campo-saida" readonly spellcheck="false" autocomplete="off" />
                <button type="button" class="botao botao-escuro" data-copiar="#senha-resultado"><icone nome="copiar" />Copiar</button>
            </div>

            <p id="senha-forca" class="forca"
               data-rotulo="Força"
               data-fraca="fraca"
               data-media="média"
               data-forte="forte"></p>

            <div class="acoes">
                <button type="button" id="senha-gerar" class="botao botao-primario"><icone nome="atualizar" />Gerar outra</button>
            </div>
        </section>
    </div>
</main>

@section Scripts {
    <script src="~/js/gerar-senha.js" asp-append-version="true"></script>
}
