<main class="lp-main">
    <div class="shell">
        <div class="lp-body">

            <header class="lp-header">
                <p class="lp-section-title"><a asp-controller="Ferramentas" asp-action="Index">ferramentas.</a></p>
                <h1 class="lp-name">gerador de senha</h1>
            </header>

            <section class="lp-section">
                <p class="lp-section-title">// opções</p>
                <div class="tool-field">
                    <label class="tool-field-label" for="pwd-length">comprimento: <span id="pwd-length-value">16</span></label>
                    <input type="range" id="pwd-length" class="tool-range" min="4" max="64" step="1" value="16" />
                </div>
                <div class="tool-options">
                    <label class="tool-option">
                        <input type="checkbox" id="pwd-upper" checked />
                        <span>maiúsculas (A-Z)</span>
                    </label>
                    <label class="tool-option">
                        <input type="checkbox" id="pwd-lower" checked />
                        <span>minúsculas (a-z)</span>
                    </label>
                    <label class="tool-option">
                        <input type="checkbox" id="pwd-numbers" checked />
                        <span>números (0-9)</span>
                    </label>
                    <label class="tool-option">
                        <input type="checkbox" id="pwd-symbols" checked />
                        <span>símbolos (!@@#...)</span>
                    </label>
                </div>
                <div class="tool-actions">
                    <button id="pwd-generate" class="lp-btn">gerar</button>
                </div>
            </section>

            <section class="lp-section">
                <p class="lp-section-title">// senha</p>
                <input type="text" id="pwd-output" class="tool-input" readonly />
                <p id="pwd-strength" class="tool-strength"
                   data-rotulo="força"
                   data-fraca="fraca"
                   data-media="média"
                   data-forte="forte"></p>
                <div class="tool-actions">
                    <button id="pwd-copy" class="lp-btn" data-copiar="#pwd-output">copiar</button>
                </div>
            </section>

        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/gerar-senha.js" asp-append-version="true"></script>
}
