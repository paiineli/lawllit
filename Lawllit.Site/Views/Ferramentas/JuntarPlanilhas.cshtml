@{
    var ferramenta = Ferramentas.Por("JuntarPlanilhas");
    ViewData["Title"] = $"{ferramenta.Nome} · lawllit.";
    ViewData["Descricao"] = ferramenta.Descricao;
}

@section Estilos {
    <link rel="stylesheet" href="~/css/ferramentas.css" asp-append-version="true" />
}

<main class="conteiner">
    <partial name="_Cabecalho" model="ferramenta" />

    <div class="ferramenta-corpo">
        <section class="cartao pilha painel">
            <h2 class="painel-titulo"><span class="painel-numero">1</span>Escolha as planilhas</h2>

            <form class="pilha" asp-controller="Ferramentas" asp-action="JuntarPlanilhas" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <label class="envio" data-acumula>
                    <input type="file" id="arquivos-entrada" name="files" multiple accept=".xlsx,.xls" />
                    <span class="envio-icone"><icone nome="upload" /></span>
                    <span class="titulo-cartao envio-titulo"><span class="so-celular">Toque para escolher</span><span class="so-computador">Clique ou arraste as planilhas aqui</span></span>
                    <span class="texto-pequeno texto-suave">Duas ou mais, em XLSX ou XLS. Dá para escolher aos poucos. Elas não saem do seu aparelho.</span>
                </label>

                <ol id="arquivos-lista" class="lista arquivos" aria-label="Ordem dos arquivos" hidden></ol>

                <button type="submit" id="arquivos-unificar" class="botao botao-primario botao-grande botao-bloco" disabled><icone nome="download" />Juntar e baixar</button>
            </form>
        </section>

        <section class="cartao pilha painel">
            <h2 class="painel-titulo">Como funciona</h2>
            <ol class="passos">
                <li><span class="painel-numero">1</span><span>Escolha as planilhas, de uma vez ou aos poucos. O x tira uma da lista.</span></li>
                <li><span class="painel-numero">2</span><span>O cabeçalho vem da primeira, e ele não se repete no meio.</span></li>
                <li><span class="painel-numero">3</span><span>As linhas de todas entram em sequência, na ordem da lista.</span></li>
                <li><span class="painel-numero">4</span><span>Uma planilha só é baixada na hora.</span></li>
            </ol>
            <p class="alerta alerta-info"><icone nome="info" />Só a primeira aba de cada arquivo entra na junção.</p>
        </section>
    </div>
</main>

<div id="progresso" class="progresso" hidden>
    <div class="cartao pilha progresso-cartao" role="status" aria-live="polite">
        <p class="titulo-cartao">Juntando...</p>
        <p id="progresso-rotulo" class="texto-suave" data-molde="Arquivo {0} de {1}"></p>
        <div class="barra-trilho"><div id="progresso-barra" class="barra-preenchimento"></div></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx@@0.18.5/dist/xlsx.full.min.js" integrity="sha384-vtjasyidUo0kW94K5MXDXntzOJpQgBKXmE7e2Ga4LG0skTTLeBi97eFAXsqewJjw" crossorigin="anonymous"></script>
    <script src="~/js/envio.js" asp-append-version="true"></script>
    <script src="~/js/lista-arquivos.js" asp-append-version="true"></script>
    <script src="~/js/juntar-planilhas.js" asp-append-version="true"></script>
}
