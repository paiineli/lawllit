@model ErrorViewMOD
@{
    ViewData["Title"] = "error";
}

<section class="error-section">
    <span class="error-tag">// error</span>
    <p>something went wrong.</p>
    @if (Model.ShowRequestId)
    {
        <p class="error-note">request id: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" asp-area="" class="lp-btn">go home</a>
</section>
