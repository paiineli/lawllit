@model ErroViewModel
@{
    ViewData["Title"] = "Erro · lawllit.";
}

<main class="conteiner erro-pagina">
    <p class="rotulo">Erro</p>
    <h1 class="titulo-grande">Alguma coisa deu errado.</h1>
    <p class="texto-grande texto-suave">Tente de novo daqui a pouco. Se continuar, me avisa pelo e-mail.</p>
    @if (Model.MostrarCodigo)
    {
        <p class="texto-pequeno texto-suave">Código da requisição: <code>@Model.CodigoRequisicao</code></p>
    }
    <a asp-controller="Inicio" asp-action="Index" class="botao botao-escuro">Voltar ao início</a>
</main>
