@{
    var currentLanguage = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var pageTitle = (ViewData["Title"] as string) ?? Localizer["SiteTitle"].Value;
    var canonicalUrl = SeoUrls.Canonical(Context.Request);
    var socialImageUrl = SeoUrls.Absolute(Context.Request, "/og-image.png");
}
<!DOCTYPE html>
<html lang="@currentLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@Localizer["SiteDescription"]" />
    <link rel="canonical" href="@canonicalUrl" />
    @foreach (var language in Constants.ValidLanguages)
    {
        <link rel="alternate" hreflang="@language" href="@SeoUrls.ForCulture(Context.Request, language)" />
    }
    <link rel="alternate" hreflang="x-default" href="@SeoUrls.ForCulture(Context.Request, Constants.DefaultLanguage)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="lawllit" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@Localizer["SiteDescription"]" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@socialImageUrl" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@Localizer["SiteDescription"]" />
    <meta name="twitter:image" content="@socialImageUrl" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23000'/><text x='50%25' y='55%25' dominant-baseline='middle' text-anchor='middle' fill='%23fff' font-family='monospace' font-weight='bold' font-size='18'>L.</text></svg>" />
    @* A fonte é declarada dentro do app.css, então sem este preload o navegador só
       descobriria o arquivo depois de baixar o CSS. O endereço tem que ser idêntico ao
       que o CSS pede, sem hash de versão, senão o arquivo é baixado duas vezes. *@
    <link rel="preload" href="~/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    @* O site público não carrega mais o Bootstrap. As classes de layout que ele usava
       estão no app.css, e o menu do celular está no site.js, em vinte linhas. *@
    <nav id="main-nav">
        <div class="nav-shell">
            <a class="brand" asp-controller="Home" asp-action="Index">lawllit<span class="brand-dot">.</span></a>

            <button type="button" class="nav-toggle" id="nav-toggle"
                    aria-controls="nav-menu" aria-expanded="false" aria-label="@Localizer["Nav_Menu"]">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M3 6h18M3 12h18M3 18h18" />
                </svg>
            </button>

            <div class="nav-menu" id="nav-menu">
                <ul class="nav-links">
                    <li>
                        <a class="nav-link nav-link-finance" asp-area="Finance" asp-controller="Home" asp-action="Index">finance</a>
                    </li>
                    <li aria-hidden="true"><span class="nav-pipe">|</span></li>
                    <li>
                        <a class="nav-link" asp-controller="Tools" asp-action="Index">@Localizer["Nav_Tools"]</a>
                    </li>
                    <li aria-hidden="true"><span class="nav-pipe">|</span></li>
                    <li>
                        <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="contact">@Localizer["Nav_Contact"]</a>
                    </li>
                </ul>

                <span class="nav-pipe" aria-hidden="true">|</span>

                <form asp-controller="Home" asp-action="SetLanguage" method="post" class="lang-switcher">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit" name="language" value="pt-BR" class="lang-btn @(currentLanguage == "pt-BR" ? "lang-btn-active" : "")" aria-label="Português"><partial name="_FlagBr" /></button>
                    <button type="submit" name="language" value="en-US" class="lang-btn @(currentLanguage == "en-US" ? "lang-btn-active" : "")" aria-label="English"><partial name="_FlagUs" /></button>
                </form>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer class="site-footer">
        <div class="footer-shell">
            <span>© @DateTime.Now.Year <span class="footer-brand">lawllit<span class="brand-dot">.</span></span></span>
            <div class="footer-links">
                <a href="mailto:support@lawllit.com" aria-label="Email"><i class="bi bi-envelope"></i></a>
                <a href="https://www.linkedin.com/in/paiineli/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
