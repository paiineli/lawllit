@inject IConfiguration Configuration
@{
    var tituloPagina = (ViewData["Title"] as string) ?? "lawllit.";
    var urlCanonica = SeoUrls.Canonica(Context.Request);
    var urlImagemSocial = SeoUrls.Absoluta(Context.Request, "/og-image.png");

    // A página não cita tecnologia em lugar nenhum, porque quem lê é cliente. Os termos
    // ficam aqui, que o buscador lê e o visitante não vê.
    var descricao = "Desenvolvimento de sistemas web sob medida em .NET e C#. Aplicações, integrações e banco de dados, do orçamento à entrega.";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@tituloPagina</title>
    <meta name="description" content="@descricao" />
    <link rel="canonical" href="@urlCanonica" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="lawllit" />
    <meta property="og:title" content="@tituloPagina" />
    <meta property="og:description" content="@descricao" />
    <meta property="og:url" content="@urlCanonica" />
    <meta property="og:image" content="@urlImagemSocial" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@tituloPagina" />
    <meta name="twitter:description" content="@descricao" />
    <meta name="twitter:image" content="@urlImagemSocial" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23000'/><text x='50%25' y='55%25' dominant-baseline='middle' text-anchor='middle' fill='%23fff' font-family='monospace' font-weight='bold' font-size='18'>L.</text></svg>" />
    @* A fonte é declarada dentro do app.css, então sem este preload o navegador só
       descobriria o arquivo depois de baixar o CSS. O endereço tem que ser idêntico ao
       que o CSS pede, sem hash de versão, senão o arquivo é baixado duas vezes. *@
    <link rel="preload" href="~/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    @* O site público não carrega o Bootstrap. O container-lg é copiado dele no app.css,
       para nav e rodapé terem a mesma largura do finance, e o menu do celular está no
       site.js, em trinta linhas. *@
    <nav class="menu-topo">
        <div class="container-lg menu-linha">
            <a class="marca" asp-controller="Inicio" asp-action="Index">lawllit<span class="marca-ponto">.</span></a>

            <button type="button" class="menu-botao" id="menu-botao"
                    aria-controls="menu-itens" aria-expanded="false" aria-label="Abrir menu">
                <svg class="icone-abrir" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M3 6h18M3 12h18M3 18h18" />
                </svg>
                <svg class="icone-fechar" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M5 5l14 14M19 5L5 19" />
                </svg>
            </button>

            <ul class="menu-itens" id="menu-itens">
                <li><a class="menu-item" asp-controller="Inicio" asp-action="Index" asp-fragment="servicos">serviços</a></li>
                <li><a class="menu-item" asp-controller="Inicio" asp-action="Index" asp-fragment="projetos">projetos</a></li>
                <li><a class="menu-item menu-item-finance" href="@Configuration["Finance:Url"]">finance</a></li>
                <li><a class="menu-item" asp-controller="Ferramentas" asp-action="Index">ferramentas</a></li>
                <li><a class="menu-item menu-item-acao" asp-controller="Inicio" asp-action="Index" asp-fragment="contato">pedir orçamento</a></li>
            </ul>
        </div>
    </nav>

    @RenderBody()

    <footer class="rodape">
        <div class="container-lg rodape-linha">
            <span>© @DateTime.Now.Year <span class="rodape-marca">lawllit<span class="marca-ponto">.</span></span></span>
            <div class="rodape-links">
                <a href="mailto:@Perfil.Email" aria-label="Email"><i class="bi bi-envelope"></i></a>
                <a href="https://www.linkedin.com/in/paiineli/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
