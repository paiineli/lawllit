@inject IConfiguration Configuration
@{
    var tituloPagina = (ViewData["Title"] as string) ?? "lawllit.";
    var urlCanonica = SeoUrls.Canonica(Context.Request);
    var urlImagemSocial = SeoUrls.Absoluta(Context.Request, "/og-image.png");
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    // A página não cita tecnologia em lugar nenhum, porque quem lê é cliente. Os termos
    // ficam aqui, que o buscador lê e o visitante não vê.
    var descricao = (ViewData["Descricao"] as string)
        ?? "Desenvolvimento de sistemas web sob medida em .NET e C#. Aplicações, integrações e banco de dados, do orçamento à entrega.";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@tituloPagina</title>
    <meta name="description" content="@descricao" />
    <link rel="canonical" href="@urlCanonica" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="lawllit" />
    <meta property="og:title" content="@tituloPagina" />
    <meta property="og:description" content="@descricao" />
    <meta property="og:url" content="@urlCanonica" />
    <meta property="og:image" content="@urlImagemSocial" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@tituloPagina" />
    <meta name="twitter:description" content="@descricao" />
    <meta name="twitter:image" content="@urlImagemSocial" />
    <partial name="_RecursosLawllit" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body>
    <header class="topo">
        <div class="conteiner topo-linha">
            <a class="marca" asp-controller="Inicio" asp-action="Index">lawllit<span class="marca-ponto">.</span></a>

            @* No celular os nomes viram ícone e o pedido de orçamento sai, porque a home tem o botão fixo embaixo. *@
            <nav class="menu-pilula menu-site" aria-label="Principal">
                <a asp-controller="Inicio" asp-action="Index" aria-current="@(controller == "Inicio" ? "page" : null)" aria-label="Home">
                    <icone nome="casa" class="so-celular" /><span class="so-computador">Home</span>
                </a>
                <a href="@Configuration["Finance:Url"]" aria-label="Finance">
                    <icone nome="carteira" class="so-celular" /><span class="so-computador">Finance</span>
                </a>
                <a asp-controller="Ferramentas" asp-action="Index" aria-current="@(controller == "Ferramentas" ? "page" : null)" aria-label="Ferramentas">
                    <icone nome="ferramenta" class="so-celular" /><span class="so-computador">Ferramentas</span>
                </a>
                <a asp-controller="Jogos" asp-action="Index" aria-current="@(controller == "Jogos" ? "page" : null)" aria-label="Jogos">
                    <icone nome="controle" class="so-celular" /><span class="so-computador">Jogos</span>
                </a>
                <button type="button" class="botao botao-icone menu-tema" data-alternar-tema aria-label="Trocar entre tema claro e escuro">
                    <icone nome="lua" class="icone-lua" />
                    <icone nome="sol" class="icone-sol" />
                </button>
                <a class="botao botao-escuro so-computador" asp-controller="Inicio" asp-action="Index" asp-fragment="contato">Pedir orçamento</a>
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer class="rodape">
        <div class="conteiner linha-espacada">
            <a class="marca marca-rodape" asp-controller="Inicio" asp-action="Index">lawllit<span class="marca-ponto">.</span></a>
            <nav class="rodape-links" aria-label="Rodapé">
                <a href="@Configuration["Finance:Url"]">Finance</a>
                <a asp-controller="Ferramentas" asp-action="Index">Ferramentas</a>
                <a asp-controller="Jogos" asp-action="Index">Jogos</a>
                <a href="@Perfil.CurriculoPdf" target="_blank">Currículo</a>
                <a href="https://@Perfil.LinkedIn" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                <a href="https://@Perfil.GitHub" target="_blank" rel="noopener noreferrer">GitHub</a>
                <a href="mailto:@Perfil.Email">@Perfil.Email</a>
            </nav>
        </div>
    </footer>

    <script src="~/_content/Lawllit.Web/js/lawllit.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
