@model PainelJogoViewModel

@* O card inteiro é o link, então nada dentro dele pode ser outro link. *@
<a class="jogo-cartao @Model.Jogo.Classe" asp-controller="Jogos" asp-action="@Model.Jogo.Acao">
    @* Capa como a da biblioteca da Steam: a arte oficial de fundo e a logo por cima dela. *@
    <div class="jogo-cartao-capa">
        <img class="jogo-cartao-arte" src="@Url.Content(Model.Jogo.Arte)" alt="" loading="lazy" />
        <h2 class="jogo-cartao-nome"><partial name="_LogoJogo" model="Model.Jogo" /></h2>
        @if (Model.QuantidadeAoVivo > 0)
        {
            <span class="ao-vivo jogo-cartao-vivo">@Model.QuantidadeAoVivo ao vivo</span>
        }
    </div>

    <div class="jogo-cartao-corpo">
        @if (Model.Agenda is { } agenda)
        {
            @if (Model.Destaque is { } destaque)
            {
                <p class="jogo-cartao-rotulo">@(destaque.AoVivo ? "Ao vivo agora" : $"Próxima partida {Model.Quando(destaque.Partida.Inicio)}")</p>
                <partial name="_Confronto" model="destaque" />
                <p class="texto-pequeno texto-suave">@destaque.Partida.Campeonato</p>
            }
            else if (agenda.Sucesso)
            {
                <p class="jogo-cartao-vazio"><icone nome="calendario" />Nenhuma partida marcada nos campeonatos grandes.</p>
            }
            else
            {
                <p class="jogo-cartao-vazio"><icone nome="alerta" />@agenda.Mensagem</p>
            }
        }

        @if (Model.Shrine is { } shrine)
        {
            @if (shrine.Valor is { } semana)
            {
                <div>
                    <p class="jogo-cartao-rotulo">Shrine of Secrets</p>
                    <p class="jogo-cartao-destaque">Troca @Model.Quando(semana.Fim)</p>
                </div>
                <div class="jogo-miniaturas">
                    @foreach (var perk in semana.Perks)
                    {
                        @if (perk.Icone is { } icone)
                        {
                            <img class="jogo-miniatura" src="@icone" alt="@perk.Nome" title="@perk.Nome" loading="lazy" width="56" height="56" />
                        }
                        else
                        {
                            <span class="jogo-miniatura jogo-miniatura-nome">@perk.Nome</span>
                        }
                    }
                </div>
            }
            else
            {
                <p class="jogo-cartao-vazio"><icone nome="alerta" />@shrine.Mensagem</p>
            }
        }

        @if (Model.Baro is { } baro)
        {
            @if (baro.Valor is { } visita)
            {
                <div class="jogo-baro-resumo">
                    <img class="jogo-baro-avatar" src="@Jogos.ImagemBaro" alt="" loading="lazy" width="56" height="56" />
                    <div>
                        <p class="jogo-cartao-rotulo">Baro Ki'Teer</p>
                        <p class="jogo-cartao-destaque">@(Model.BaroPresente ? $"Na relay até {Model.Quando(visita.Partida)}" : $"Chega {Model.Quando(visita.Chegada)}")</p>
                        <p class="texto-pequeno texto-suave">@visita.Local</p>
                    </div>
                </div>

                @if (Model.BaroPresente)
                {
                    <div class="jogo-miniaturas">
                        @foreach (var item in visita.Itens.Where(item => item.Imagem is not null).Take(5))
                        {
                            <img class="jogo-miniatura" src="@item.Imagem" alt="@item.Nome" title="@item.Nome" loading="lazy" width="56" height="56" />
                        }
                    </div>
                }
            }
            else
            {
                <p class="jogo-cartao-vazio"><icone nome="alerta" />@baro.Mensagem</p>
            }
        }
    </div>

    <div class="jogo-cartao-rodape">
        <span class="jogo-cartao-patch">@(Model.Patch?.Titulo ?? "Patch indisponível")</span>
        <span class="jogo-cartao-abrir">Abrir <icone nome="seta-direita" /></span>
    </div>
</a>
