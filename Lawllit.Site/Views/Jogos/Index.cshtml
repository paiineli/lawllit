@model PainelJogoViewModel[]
@{
    ViewData["Title"] = "Jogos · lawllit.";
    ViewData["Descricao"] = "Agenda dos campeonatos de Valorant, LoL e Dota 2 no horário de Brasília, o Shrine of Secrets da semana, o Baro Ki'Teer e o patch mais recente de cada jogo.";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/jogos.css" asp-append-version="true" />
}

<main>
<section class="conteiner jogos-topo">
    <h1 class="titulo-gigante">Jogos<span class="destaque">.</span></h1>
    <p class="texto-grande texto-suave jogos-sub">Campeonato, o que mudou na semana e o patch de cada jogo, num lugar só e sempre no horário de Brasília.</p>
</section>

<section class="conteiner">
    <div class="jogos-grade">
        @foreach (var painel in Model)
        {
            <partial name="_CartaoJogo" model="painel" />
        }
    </div>

    <partial name="_Fontes" />
</section>
</main>
