@model DiaAgendaViewModel

<div class="agenda-dia">
    <p class="agenda-dia-rotulo">@Model.Rotulo</p>

    @foreach (var item in Model.Partidas)
    {
        var partida = item.Partida;
        var classe = partida.Concluida ? "partida partida-concluida" : item.AoVivo ? "partida partida-ao-vivo" : "partida";
        <article class="@classe">
            <div class="partida-topo">
                <span class="partida-hora">@item.Hora</span>
                @if (item.AoVivo)
                {
                    <span class="ao-vivo">ao vivo</span>
                }
                <span class="partida-formato">@partida.Formato</span>
            </div>

            <partial name="_Confronto" model="item" />

            <div class="partida-rodape">
                <span class="partida-campeonato">@partida.Campeonato</span>
                <span class="partida-links">
                    @if (partida.LinkTransmissao is { } transmissao)
                    {
                        <a class="partida-assistir" href="@transmissao" target="_blank" rel="noopener noreferrer">assistir</a>
                    }
                    @if (partida.LinkPartida is { } detalhes)
                    {
                        <a href="@detalhes" target="_blank" rel="noopener noreferrer">detalhes</a>
                    }
                </span>
            </div>
        </article>
    }
</div>
