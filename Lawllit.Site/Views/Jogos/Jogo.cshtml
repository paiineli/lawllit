@model PainelJogoViewModel
@{
    ViewData["Title"] = $"{Model.Jogo.Nome} · lawllit.";
    ViewData["Descricao"] = $"{Model.Jogo.Nome}: campeonatos, novidades da semana e o patch mais recente, no horário de Brasília.";

    var proximas = Model.ProximasPorDia;
    var resultados = Model.ResultadosPorDia;
}

@section Estilos {
    <link rel="stylesheet" href="~/css/jogos.css" asp-append-version="true" />
}

@* A classe do jogo fica em volta de tudo, e é ela que pinta a página com as cores dele. *@
<div class="jogo-pagina @Model.Jogo.Classe">
    <div class="conteiner">
        <header class="jogo-capa">
            <img class="jogo-capa-arte" src="@Url.Content(Model.Jogo.Arte)" alt="" />

            <div class="jogo-capa-conteudo">
                <a class="jogo-voltar" asp-controller="Jogos" asp-action="Index"><icone nome="chevron-esquerda" />Jogos</a>

                <h1 class="jogo-titulo"><partial name="_LogoJogo" model="Model.Jogo" /></h1>

                @if (Model.Atualizacoes.Count > 0)
                {
                    <div class="jogo-patches">
                        @foreach (var atualizacao in Model.Atualizacoes)
                        {
                            <a class="jogo-patch" href="@atualizacao.Link" target="_blank" rel="noopener noreferrer">
                                @if (atualizacao.Jogo != Model.Jogo.Codigo)
                                {
                                    <span class="jogo-patch-rotulo">@atualizacao.Jogo</span>
                                }
                                <span>@atualizacao.Titulo</span>
                                @if (atualizacao.Data is { } data)
                                {
                                    <span class="jogo-patch-rotulo">@data.ToString("dd/MM")</span>
                                }
                                <icone nome="seta-diagonal" />
                            </a>
                        }
                    </div>
                }
            </div>
        </header>
    </div>

    @if (Model.Agenda is { } agenda)
    {
        <section class="conteiner jogo-secao" aria-labelledby="agenda-titulo">
            <div class="jogo-secao-topo">
                <h2 class="titulo-secao" id="agenda-titulo">Agenda</h2>
                <div class="chips">
                    <span class="selo"><icone nome="relogio" />Horário de Brasília</span>
                    @if (agenda.Valor is { } lida)
                    {
                        <span class="selo"><icone nome="atualizar" />Atualizada @Model.Quando(lida.AtualizadoEm)</span>
                    }
                </div>
            </div>

            @if (!agenda.Sucesso)
            {
                <div class="estado-vazio"><icone nome="alerta" /><p>@agenda.Mensagem</p></div>
            }
            else
            {
                <div class="agenda">
                    @* Rádio e não JavaScript, porque o CSS lê qual está marcado e esconde a outra coluna no celular. *@
                    <div class="segmentado segmentado-bloco agenda-alternar" role="radiogroup" aria-label="O que mostrar na agenda">
                        <label><input type="radio" name="agenda-ver" value="proximas" checked />Próximas</label>
                        <label><input type="radio" name="agenda-ver" value="resultados" />Resultados</label>
                    </div>

                    <div class="agenda-proximas">
                        <h3 class="titulo-cartao agenda-coluna-titulo">Próximas</h3>
                        @if (proximas.Count == 0)
                        {
                            <div class="estado-vazio"><icone nome="calendario" /><p>Nenhuma partida marcada nos campeonatos grandes.</p></div>
                        }
                        @foreach (var dia in proximas)
                        {
                            <partial name="_DiaAgenda" model="dia" />
                        }
                    </div>

                    <div class="agenda-resultados">
                        <h3 class="titulo-cartao agenda-coluna-titulo">Resultados</h3>
                        @if (resultados.Count == 0)
                        {
                            <div class="estado-vazio"><icone nome="trofeu" /><p>Nenhum resultado recente nos campeonatos grandes.</p></div>
                        }
                        @foreach (var dia in resultados)
                        {
                            <partial name="_DiaAgenda" model="dia" />
                        }
                    </div>
                </div>
            }
        </section>
    }

    @if (Model.Shrine is { } shrine)
    {
        <section class="conteiner jogo-secao" aria-labelledby="shrine-titulo">
            <div class="jogo-secao-topo">
                <h2 class="titulo-secao" id="shrine-titulo">Shrine of Secrets</h2>
                @if (shrine.Valor is { } semana)
                {
                    <span class="selo"><icone nome="relogio" />Troca @Model.Quando(semana.Fim)</span>
                }
            </div>

            @if (shrine.Valor is { } perks)
            {
                <p class="texto-suave jogo-secao-sub">As perks à venda nesta semana, pagas com fragmentos iridescentes.</p>

                <div class="vitrine">
                    @foreach (var perk in perks.Perks)
                    {
                        <article class="vitrine-item">
                            <div class="vitrine-imagem">
                                @if (perk.Icone is { } icone)
                                {
                                    <img src="@icone" alt="" loading="lazy" width="96" height="96" />
                                }
                                else
                                {
                                    <icone nome="imagem" />
                                }
                            </div>
                            <h3 class="vitrine-nome">@perk.Nome</h3>
                            <span class="texto-pequeno texto-suave">@perk.Personagem</span>
                            <span class="vitrine-preco">@perk.Fragmentos.ToString("N0") fragmentos</span>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="estado-vazio"><icone nome="alerta" /><p>@shrine.Mensagem</p></div>
            }
        </section>
    }

    @if (Model.Baro is { } baro)
    {
        <section class="conteiner jogo-secao" aria-labelledby="baro-titulo">
            <div class="jogo-secao-topo">
                <h2 class="titulo-secao" id="baro-titulo">Baro Ki'Teer</h2>
            </div>

            @if (baro.Valor is not { } visita)
            {
                <div class="estado-vazio"><icone nome="alerta" /><p>@baro.Mensagem</p></div>
            }
            else
            {
                <div class="baro-status">
                    <img class="jogo-baro-avatar" src="@Jogos.ImagemBaro" alt="" width="80" height="80" />
                    <div class="pilha baro-status-texto">
                        @if (Model.BaroPresente)
                        {
                            <span class="ao-vivo">Na relay agora</span>
                            <p class="titulo-cartao">@visita.Local</p>
                            <p class="baro-status-detalhe">Vai embora @Model.Quando(visita.Partida).</p>
                        }
                        else
                        {
                            <p class="titulo-cartao">Chega @Model.Quando(visita.Chegada)</p>
                            <p class="baro-status-detalhe">Na @visita.Local, e fica até @Model.Quando(visita.Partida). O estoque aparece aqui quando ele chegar.</p>
                        }
                    </div>
                </div>

                @if (Model.BaroPresente)
                {
                    <div class="vitrine">
                        @foreach (var item in visita.Itens)
                        {
                            <article class="vitrine-item">
                                <div class="vitrine-imagem">
                                    @if (item.Imagem is { } imagem)
                                    {
                                        <img src="@imagem" alt="" loading="lazy" width="96" height="96" />
                                    }
                                    else
                                    {
                                        <icone nome="imagem" />
                                    }
                                </div>
                                <h3 class="vitrine-nome">@item.Nome</h3>
                                @if (item.Ducats is { } ducats)
                                {
                                    <span class="vitrine-preco">@ducats.ToString("N0") ducats</span>
                                }
                                @if (item.Creditos is { } creditos)
                                {
                                    <span class="texto-pequeno texto-suave">@creditos.ToString("N0") créditos</span>
                                }
                            </article>
                        }
                    </div>
                }
            }
        </section>
    }

    <div class="conteiner jogo-rodape">
        <partial name="_Fontes" />
    </div>
</div>
