@model PartidaViewModel

@* Um time por linha e o placar na ponta, porque lado a lado o nome não cabia inteiro no celular. *@
<div class="confronto">
    @foreach (var equipe in new[] { Model.Partida.EquipeA, Model.Partida.EquipeB })
    {
        <div class="@(equipe.Vencedora ? "confronto-equipe confronto-vencedora" : "confronto-equipe")">
            <partial name="_Escudo" model="equipe" />
            <span class="confronto-nome">@equipe.Nome</span>

            @* O vencedor leva troféu e texto para leitor de tela, e não só a cor mais forte. *@
            @if (equipe.Vencedora)
            {
                <icone nome="trofeu" class="confronto-trofeu" />
                <span class="so-leitor">venceu</span>
            }

            @if (equipe.Placar is { } placar)
            {
                <span class="confronto-placar">@placar</span>
            }
        </div>
    }
</div>
