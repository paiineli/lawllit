@{
    // Os onze cards estavam escritos à mão aqui. Agora saem do SiteTools, que é a mesma
    // lista que o card de projetos da home usa.
}

<main class="lp-main">
    <div class="shell">
        <div class="lp-body">

            <header class="lp-header">
                <h1 class="lp-name">@Localizer["Tools_Title"]</h1>
                <p class="lp-text">@Localizer["Tools_Subtitle"]</p>
            </header>

            @foreach (var group in SiteTools.Groups)
            {
                <section class="lp-section">
                    <p class="lp-section-title">@Localizer[group.CategoryKey]</p>
                    <div class="tools-grid">
                        @foreach (var tool in group.Tools)
                        {
                            <a class="tool-card" asp-controller="Tools" asp-action="@tool.Action">
                                <i class="bi @tool.Icon tool-card-icon"></i>
                                <span class="tool-card-name">@Localizer[tool.NameKey]</span>
                                <span class="tool-card-desc">@Localizer[tool.DescriptionKey]</span>
                            </a>
                        }
                    </div>
                </section>
            }

        </div>
    </div>
</main>
