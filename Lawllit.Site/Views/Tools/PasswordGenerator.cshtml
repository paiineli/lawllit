<main class="lp-main">
    <div class="shell">
        <div class="lp-body">

            <header class="lp-header">
                <p class="lp-section-title"><a asp-controller="Tools" asp-action="Index">@Localizer["Tools_Title"]</a></p>
                <h1 class="lp-name">@Localizer["PasswordGenerator_Title"]</h1>
            </header>

            <section class="lp-section">
                <p class="lp-section-title">@Localizer["PasswordGenerator_OptionsTag"]</p>
                <div class="tool-field">
                    <label class="tool-field-label" for="pwd-length">@Localizer["PasswordGenerator_LengthLabel"]: <span id="pwd-length-value">16</span></label>
                    <input type="range" id="pwd-length" class="tool-range" min="4" max="64" step="1" value="16" />
                </div>
                <div class="tool-options">
                    <label class="tool-option">
                        <input type="checkbox" id="pwd-upper" checked />
                        <span>@Localizer["PasswordGenerator_Upper"]</span>
                    </label>
                    <label class="tool-option">
                        <input type="checkbox" id="pwd-lower" checked />
                        <span>@Localizer["PasswordGenerator_Lower"]</span>
                    </label>
                    <label class="tool-option">
                        <input type="checkbox" id="pwd-numbers" checked />
                        <span>@Localizer["PasswordGenerator_Numbers"]</span>
                    </label>
                    <label class="tool-option">
                        <input type="checkbox" id="pwd-symbols" checked />
                        <span>@Localizer["PasswordGenerator_Symbols"]</span>
                    </label>
                </div>
                <div class="tool-actions">
                    <button id="pwd-generate" class="lp-btn">@Localizer["PasswordGenerator_GenerateBtn"]</button>
                </div>
            </section>

            <section class="lp-section">
                <p class="lp-section-title">@Localizer["PasswordGenerator_OutputTag"]</p>
                <input type="text" id="pwd-output" class="tool-input" readonly />
                <p id="pwd-strength" class="tool-strength"
                   data-label="@Localizer["PasswordGenerator_StrengthLabel"]"
                   data-weak="@Localizer["PasswordGenerator_Strength_Weak"]"
                   data-medium="@Localizer["PasswordGenerator_Strength_Medium"]"
                   data-strong="@Localizer["PasswordGenerator_Strength_Strong"]"></p>
                <div class="tool-actions">
                    <button id="pwd-copy" class="lp-btn">@Localizer["PasswordGenerator_CopyBtn"]</button>
                </div>
            </section>

        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/password-generator.js" asp-append-version="true"></script>
}
